services:
  db:
    image: mariadb:10.11
    container_name: seafile-mysql
    environment:
      - MYSQL_ROOT_PASSWORD={{ seafile_db_root_password }} # Required, set the root's password of MySQL service.
      - MYSQL_LOG_CONSOLE=true
      - MARIADB_AUTO_UPGRADE=1
    volumes:
      - {{ seafile_root_dir }}/db:/var/lib/mysql  # Required, specifies the path to MySQL data persistent store.
    networks:
      - seafile-net

  memcached:
    image: memcached:1.6.18
    container_name: seafile-memcached
    entrypoint: memcached -m 256
    networks:
      - seafile-net
          
  seafile:
    image: seafileltd/seafile-mc:11.0-latest
    container_name: seafile
    ports:
      - "{{ seafile_ext_port }}:80"
      - "{{ seafile_ext_https_port }}:443"
      - "{{ seafile_ext_webdav_port }}:{{ seafile_ext_webdav_port }}"
    volumes:
      - {{ seafile_data_dir }}/data:/shared   # Required, specifies the path to Seafile data persistent store.
      - {{ seafile_root_dir }}/config/seafdav.conf:/opt/seafile-data/seafile/conf/seafdav.conf:ro
    environment:
      - DB_HOST=db
      - DB_ROOT_PASSWD={{ seafile_db_root_password }} # Required, the value should be root's password of MySQL service.
      - TIME_ZONE={{ timezone }}  # Optional, default is UTC. Should be uncomment and set to your local time zone.
      - SEAFILE_ADMIN_EMAIL={{ seafile_admin_email }}  # Specifies Seafile admin user, default is 'me@example.com'.
      - SEAFILE_ADMIN_PASSWORD={{ seafile_admin_password }}     # Specifies Seafile admin password, default is 'asecret'.
      - SEAFILE_SERVER_LETSENCRYPT=true # Whether to use https or not.
      - SEAFILE_SERVER_HOSTNAME={{ seafile_server_hostname }} # Specifies your host name if https is enabled.
    depends_on:
      - db
      - memcached
    networks:
      - seafile-net

networks:
  seafile-net: {}
