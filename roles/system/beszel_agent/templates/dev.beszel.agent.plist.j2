<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by Ansible (roles/system/beszel_agent) — do not edit by hand. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ beszel_agent_macos_label }}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ beszel_agent_install_dir }}/beszel-agent</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>{{ beszel_agent_port }}</string>
        <key>KEY</key>
        <string>{{ beszel_agent_key }}</string>
    </dict>
    <key>UserName</key>
    <string>{{ user }}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{ beszel_agent_install_dir }}/agent.log</string>
    <key>StandardErrorPath</key>
    <string>{{ beszel_agent_install_dir }}/agent.err.log</string>
</dict>
</plist>
