networks:
  servarrnetwork:
    name: servarrnetwork
    ipam:
      config:
        - subnet: 172.39.0.0/24

services:
  gluetun:
    image: qmcgaw/gluetun
    container_name: gluetun
    hostname: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun # If running on an LXC see readme for more info.
    networks:
      servarrnetwork:
        ipv4_address: 172.39.0.2
    ports:
      - {{ arr_qbittorrent_ext_port }}:{{ arr_qbittorrent_ext_port }} # qbittorrent web interface
      - {{ arr_nzbget_ext_port }}:6789 # nzbget web interface
      - {{ arr_prowlarr_ext_port }}:9696 # prowlarr web interface
      - {{ arr_whisparr_ext_port }}:6969 # whisparr web interface
      - {{ arr_sonarr_ext_port }}:8989 # sonarr web interface
      - {{ arr_radarr_ext_port }}:7878 # radarr web interface
      - {{ arr_lidarr_ext_port }}:8686 # lidarr web interface
      - {{ arr_ytdl_sub_ext_port }}:8443 # ytdl-sub web interface
      - {{ arr_unpackerr_ext_port }}:5656 # unpackerr port
    volumes:
      - {{ media_base_dir }}/config/gluetun:/config
      - {{ media_base_dir }}/service/gluetun:/gluetun
    # Make a '.env' file in the same directory.
    env_file:
      - .env
    healthcheck:
      test: ping -c 1 www.google.com || exit 1
      interval: 20s
      timeout: 10s
      retries: 5
    restart: unless-stopped

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:5.1.0
    container_name: qbittorrent
    restart: unless-stopped
    labels:
      - deunhealth.restart.on.unhealthy=true
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
      - WEBUI_PORT={{ arr_qbittorrent_ext_port }} # must match "qbittorrent web interface" port number in gluetun's service above
    volumes:
      - {{ media_base_dir }}/config/qbittorrent:/config
      - {{ media_out_dir }}/data:/data
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    network_mode: service:gluetun
    healthcheck:
      test: ping -c 1 www.google.com || exit 1
      interval: 60s
      retries: 3
      start_period: 20s
      timeout: 10s

  qbittorrent-port:
    image: charlocharlie/qbittorrent-port-forward-file:latest
    container_name: gluetun-qbittorrent-portfw
    labels:
      - deunhealth.restart.on.unhealthy=true
    environment:
      - QBT_USERNAME={{ arr_qbittorrent_user }}
      - QBT_PASSWORD={{ arr_qbittorrent_password }}
      - QBT_ADDR=http://gluetun:{{ arr_qbittorrent_ext_port }}
      - PORT_FILE=/config/port-forwarding-status.txt
    volumes:
      - {{ media_base_dir }}/config/gluetun:/config
    restart: unless-stopped
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_healthy
      qbittorrent:
        condition: service_healthy

  # See the 'qBittorrent Stalls with VPN Timeout' section for more information.
  deunhealth:
    image: qmcgaw/deunhealth
    container_name: deunhealth
    network_mode: "none"
    environment:
      - LOG_LEVEL=info
      - HEALTH_SERVER_ADDRESS=127.0.0.1:9999
      - TZ=${TZ}
    restart: always
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock

  nzbget:
    image: lscr.io/linuxserver/nzbget:latest
    container_name: nzbget
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/nzbget:/config
      - {{ media_base_dir }}/service/nzbget:/data
      - {{ media_out_dir }}/data:/data
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    restart: unless-stopped
    network_mode: service:gluetun

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/prowlarr:/config
    restart: unless-stopped
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    network_mode: service:gluetun

  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    restart: unless-stopped
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/sonarr:/config
      - {{ media_out_dir }}/data:/data # output directory of qbittorrent should be same as sonarr's data directory
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true

  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    restart: unless-stopped
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/radarr:/config
      - {{ media_out_dir }}/data:/data # output directory of qbittorrent should be same as radarr's data directory
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true


  lidarr:
    container_name: lidarr
    image: lscr.io/linuxserver/lidarr:latest
    restart: unless-stopped
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/lidarr:/config
      - {{ media_out_dir }}/data:/data # output directory of qbittorrent should be same as lidarr's data directory
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true

  whisparr:
    image: ghcr.io/hotio/whisparr:v3
    container_name: whisparr
    restart: unless-stopped
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
      - VPN_ENABLED=false
    volumes:
      - {{ media_base_dir }}/config/whisparr:/config
      - {{ media_out_dir }}/data:/data 
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    network_mode: service:gluetun

  ytdl-sub:
    image: ghcr.io/jmbannon/ytdl-sub-gui:latest
    container_name: ytdl-sub
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    volumes:
      - {{ media_base_dir }}/config/ytdl-sub:/config
      - {{ media_out_dir }}/data/yt:/data 
    restart: unless-stopped
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
  unpackerr:
    image: golift/unpackerr
    container_name: unpackerr
    restart: unless-stopped
    user: ${PUID:?err}:${PGID:?err}
    volumes:
      - {{ media_out_dir }}/data:/data 
      - {{ media_base_dir }}/config/unpackerr:/config
      - {{ media_base_dir }}/logs/unpackerr:/var/log
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    environment:
      - TZ={{ timezone }}
    # Remove all lines that begin with UN_CMDHOOK, UN_WEBHOOK, UN_FOLDER, UN_WEBSERVER, and other apps you do not use.
    ## Global Settings
      - UN_DEBUG=false
      - UN_QUIET=false
      - UN_ERROR_STDERR=false
      - UN_ACTIVITY=false
      - UN_LOG_QUEUES=1m
      - UN_LOG_FILE=/var/log/unpackerr.log
      - UN_LOG_FILES=10
      - UN_LOG_FILE_MB=10
      - UN_LOG_FILE_MODE=0644
      - UN_INTERVAL=2m
      - UN_START_DELAY=1m
      - UN_RETRY_DELAY=5m
      - UN_MAX_RETRIES=3
      - UN_PARALLEL=1
      - UN_FILE_MODE=0644
      - UN_DIR_MODE=2755
      ## Web Server
      - UN_WEBSERVER_METRICS=true
      - UN_WEBSERVER_LISTEN_ADDR=0.0.0.0:5656
      - UN_WEBSERVER_LOG_FILE=/var/log/server.log
      - UN_WEBSERVER_LOG_FILES=10
      - UN_WEBSERVER_LOG_FILE_MB=10
      - UN_WEBSERVER_SSL_CERT_FILE=
      - UN_WEBSERVER_SSL_KEY_FILE=
      - UN_WEBSERVER_URLBASE=/
      - UN_WEBSERVER_UPSTREAMS=
      ## Folder Settings
      - UN_FOLDERS_INTERVAL=1s
      - UN_FOLDERS_BUFFER=20000
      ## Sonarr Settings
      ## Sonarr Config - Copy API Key from: http://sonarr:8989/general/settings
      - UN_SONARR_0_URL=http://172.39.0.2:8989
      - UN_SONARR_0_API_KEY={{ arr_sonarr_api_key }}
      - UN_SONARR_0_PATHS_0=/data/torrents
      - UN_SONARR_0_PATHS_1=/data/usenet/shows
      - UN_SONARR_0_PROTOCOLS=torrent,usenet
      - UN_SONARR_0_TIMEOUT=10s
      - UN_SONARR_0_DELETE_DELAY=5m
      - UN_SONARR_0_DELETE_ORIG=false
      - UN_SONARR_0_SYNCTHING=false
      ## Radarr Settings
      ## Radarr Config - Copy API Key from: http://radarr:7878/general/settings
      - UN_RADARR_0_URL=http://172.39.0.2:7878
      - UN_RADARR_0_API_KEY={{ arr_radarr_api_key }}
      - UN_RADARR_0_PATHS_0=/data/torrents
      - UN_RADARR_0_PATHS_1=/data/usenet/movies
      - UN_RADARR_0_PROTOCOLS=torrent,usenet
      - UN_RADARR_0_TIMEOUT=10s
      - UN_RADARR_0_DELETE_DELAY=5m
      - UN_RADARR_0_DELETE_ORIG=false
      - UN_RADARR_0_SYNCTHING=false
      ## Lidarr Settings
      ## Lidarr Config - Copy API Key from: http://lidarr:8686/general/settings
      - UN_LIDARR_0_URL=http://172.39.0.2:8686
      - UN_LIDARR_0_API_KEY={{ arr_lidarr_api_key }}
      - UN_LIDARR_0_PATHS_0=/data/torrents
      - UN_LIDARR_0_PATHS_1=/data/usenet/music
      - UN_LIDARR_0_PROTOCOLS=torrent,usenet
      - UN_LIDARR_0_TIMEOUT=10s
      - UN_LIDARR_0_DELETE_DELAY=5m
      - UN_LIDARR_0_DELETE_ORIG=false
      - UN_LIDARR_0_SYNCTHING=false
      ## Whisparr Settings
      ## Whisparr Config - Copy API Key from: http://whisparr:6969/general/settings
      - UN_WHISPARR_0_URL=http://172.39.0.2:6969
      - UN_WHISPARR_0_API_KEY={{ arr_whisparr_api_key }}
      - UN_WHISPARR_0_PATHS_0=/data/torrents
      - UN_WHISPARR_0_PATHS_1=/data/usenet/xxx
      - UN_WHISPARR_0_PROTOCOLS=torrent,usenet
      - UN_WHISPARR_0_TIMEOUT=10s
      - UN_WHISPARR_0_DELETE_DELAY=5m
      - UN_WHISPARR_0_DELETE_ORIG=false
      - UN_WHISPARR_0_SYNCTHING=false
