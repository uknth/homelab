networks:
  servarrnetwork:
    name: servarrnetwork
    ipam:
      config:
        - subnet: 172.39.0.0/24

services:
  gluetun:
    image: qmcgaw/gluetun
    container_name: gluetun
    hostname: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun # If running on an LXC see readme for more info.
    networks:
      servarrnetwork:
        ipv4_address: 172.39.0.2
    ports:
      - {{ arr_qbittorrent_ext_port }}:{{ arr_qbittorrent_ext_port }} # qbittorrent web interface
      - {{ arr_nzbget_ext_port }}:6789 # nzbget web interface
      - {{ arr_prowlarr_ext_port }}:9696 # prowlarr web interface
      - {{ arr_whisparr_ext_port }}:6969 # whisparr web interface
    volumes:
      - {{ media_base_dir }}/config/gluetun:/config
      - {{ media_base_dir }}/service/gluetun:/gluetun
    # Make a '.env' file in the same directory.
    env_file:
      - .env
    healthcheck:
      test: ping -c 1 www.google.com || exit 1
      interval: 20s
      timeout: 10s
      retries: 5
    restart: unless-stopped

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    restart: unless-stopped
    labels:
      - deunhealth.restart.on.unhealthy=true
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
      - WEBUI_PORT={{ arr_qbittorrent_ext_port }} # must match "qbittorrent web interface" port number in gluetun's service above
    volumes:
      - {{ media_base_dir }}/config/qbittorrent:/config
      - {{ media_base_dir }}/service/qbittorrent:/data
      - {{ media_out_dir }}/data/downloads:/data/downloads
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    network_mode: service:gluetun
    healthcheck:
      test: ping -c 1 www.google.com || exit 1
      interval: 60s
      retries: 3
      start_period: 20s
      timeout: 10s

  qbittorrent-port:
    image: charlocharlie/qbittorrent-port-forward-file:latest
    container_name: gluetun-qbittorrent-portfw
    labels:
      - deunhealth.restart.on.unhealthy=true
    environment:
      - QBT_USERNAME={{ arr_qbittorrent_user }}
      - QBT_PASSWORD={{ arr_qbittorrent_password }}
      - QBT_ADDR=http://gluetun:{{ arr_qbittorrent_ext_port }}
      - PORT_FILE=/config/port-forwarding-status.txt
    volumes:
      - {{ media_base_dir }}/config/gluetun:/config
    restart: unless-stopped
    network_mode: service:gluetun
    depends_on:
      gluetun:
        condition: service_healthy
      qbittorrent:
        condition: service_healthy

  # See the 'qBittorrent Stalls with VPN Timeout' section for more information.
  deunhealth:
    image: qmcgaw/deunhealth
    container_name: deunhealth
    network_mode: "none"
    environment:
      - LOG_LEVEL=info
      - HEALTH_SERVER_ADDRESS=127.0.0.1:9999
      - TZ=${TZ}
    restart: always
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock

  nzbget:
    image: lscr.io/linuxserver/nzbget:latest
    container_name: nzbget
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
      - PUID=${PUID}
      - PGID=${PGID}
      - TZ=${TZ}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/nzbget:/config
      - {{ media_base_dir }}/service/nzbget:/data
      - {{ media_out_dir }}/data/downloads:/downloads
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    restart: unless-stopped
    network_mode: service:gluetun

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:latest
    container_name: prowlarr
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/prowlarr:/config
    restart: unless-stopped
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    network_mode: service:gluetun

  sonarr:
    image: lscr.io/linuxserver/sonarr:latest
    container_name: sonarr
    restart: unless-stopped
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/sonarr:/config
      - {{ media_out_dir }}/data:/data # output directory of qbittorrent should be same as sonarr's data directory
    ports:
      - {{ arr_sonarr_ext_port }}:8989
    networks:
      servarrnetwork:
        ipv4_address: 172.39.0.3

  radarr:
    image: lscr.io/linuxserver/radarr:latest
    container_name: radarr
    restart: unless-stopped
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/radarr:/config
      - {{ media_out_dir }}/data:/data # output directory of qbittorrent should be same as radarr's data directory
    ports:
      - {{ arr_radarr_ext_port }}:7878
    networks:
      servarrnetwork:
        ipv4_address: 172.39.0.4

  lidarr:
    container_name: lidarr
    image: lscr.io/linuxserver/lidarr:latest
    restart: unless-stopped
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/lidarr:/config
      - {{ media_out_dir }}/data:/data # output directory of qbittorrent should be same as lidarr's data directory
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    ports:
      - {{ arr_lidarr_ext_port }}:8686
    networks:
      servarrnetwork:
        ipv4_address: 172.39.0.5

  bazarr:
    image: lscr.io/linuxserver/bazarr:latest
    container_name: bazarr
    restart: unless-stopped
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - {{ media_base_dir }}/config/bazarr:/config
      - {{ media_out_dir }}/data:/data # output directory of qbittorrent should be same as bazarr's data directory
    ports:
      - {{ arr_bazarr_ext_port }}:6767
    networks:
      servarrnetwork:
        ipv4_address: 172.39.0.6

  whisparr:
    image: ghcr.io/hotio/whisparr:v3
    container_name: whisparr
    restart: unless-stopped
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
      - VPN_ENABLED=false
    volumes:
      - {{ media_base_dir }}/config/whisparr:/config
      - {{ media_out_dir }}/data:/data 
    depends_on:
      gluetun:
        condition: service_healthy
        restart: true
    network_mode: service:gluetun

  ytdl-sub:
    image: ghcr.io/jmbannon/ytdl-sub-gui:latest
    container_name: ytdl-sub
    environment:
      - PUID={{puid}}
      - PGID={{pgid}}
      - TZ={{timezone}}
    volumes:
      - {{ media_base_dir }}/config/ytdl-sub:/config
      - {{ media_out_dir }}/data/yt:/data 
    ports:
      - {{ arr_ytdl_sub_ext_port }}:8443
    networks:
      servarrnetwork:
        ipv4_address: 172.39.0.8
    restart: unless-stopped
