<!doctype html>
<!-- Managed by Ansible — services/knowledge/vaultask -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ask — Homelab Wiki</title>
<style>
  :root { --bg:#faf8f8; --fg:#2b2b2b; --muted:#4e4e4e; --faint:#8a8a8a;
          --line:#e5e5e5; --accent:#284b63; --card:#fff; --mark:#fff236; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#161618; --fg:#ebebec; --muted:#d4d4d4; --faint:#8f8f8f;
            --line:#393639; --accent:#7b97aa; --card:#1e1e21; --mark:#b3aa02; }
  }
  * { box-sizing:border-box; }
  body { margin:0; padding:2.5rem 1.25rem 4rem; background:var(--bg); color:var(--fg);
         font-family:"Source Sans Pro",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  main { max-width:52rem; margin:0 auto; }
  h1 { font-size:1.35rem; margin:0 0 1.25rem; font-weight:600; }
  h1 a { color:inherit; text-decoration:none; }
  form { display:flex; gap:.5rem; margin-bottom:.75rem; }
  input { flex:1; padding:.8rem 1rem; font-size:1rem; border-radius:8px;
          border:1px solid var(--line); background:var(--card); color:var(--fg); }
  input:focus { outline:2px solid var(--accent); outline-offset:-1px; }
  button { padding:.8rem 1.3rem; font-size:1rem; font-weight:600; border:0; border-radius:8px;
           background:var(--accent); color:#fff; cursor:pointer; }
  .status { color:var(--faint); font-size:.85rem; min-height:1.4em; margin-bottom:1.25rem; }
  .warn { color:#b45309; }
  ul { list-style:none; padding:0; margin:0; }
  li { background:var(--card); border:1px solid var(--line); border-radius:10px;
       padding:.9rem 1rem; margin-bottom:.7rem; }
  .t { display:flex; align-items:baseline; gap:.6rem; flex-wrap:wrap; }
  .t a { color:var(--accent); font-weight:600; text-decoration:none; font-size:1.02rem; }
  .t a:hover { text-decoration:underline; }
  .topic { font-size:.7rem; text-transform:uppercase; letter-spacing:.06em;
           color:var(--faint); border:1px solid var(--line); border-radius:99px; padding:.1rem .55rem; }
  .why { font-size:.68rem; color:var(--faint); }
  .snip { color:var(--muted); font-size:.9rem; line-height:1.55; margin-top:.4rem; }
  mark { background:var(--mark); color:inherit; padding:0 .1em; border-radius:2px; }
  .tags { margin-top:.4rem; font-size:.72rem; color:var(--faint); }
  footer { margin-top:2rem; font-size:.78rem; color:var(--faint); }
  footer a { color:var(--accent); }

  /* ---- chat (ask) ---- */
  #chat { display:flex; flex-direction:column; gap:.9rem; margin-bottom:1rem; }
  .msg { border-radius:10px; padding:.8rem 1rem; }
  .msg.user { background:transparent; border:1px solid var(--line); color:var(--fg); }
  .msg.assistant { background:var(--card); border:1px solid var(--line); }
  .msg .label { font-size:.68rem; text-transform:uppercase; letter-spacing:.06em;
                color:var(--faint); margin-bottom:.35rem; }
  .answer { line-height:1.6; white-space:pre-wrap; }
  .badge { display:inline-block; font-size:.68rem; font-weight:600; letter-spacing:.02em;
           border-radius:99px; padding:.15rem .6rem; margin-bottom:.5rem; }
  .badge.wiki { background:rgba(40,75,99,.14); color:var(--accent); }
  .badge.general { background:rgba(180,83,9,.14); color:#b45309; }
  .cites { margin-top:.7rem; padding-top:.6rem; border-top:1px solid var(--line);
           font-size:.82rem; }
  .cites ol { margin:.3rem 0 0; padding-left:1.2rem; }
  .cites a { color:var(--accent); text-decoration:none; }
  .cites a:hover { text-decoration:underline; }
  .switch { font-size:.78rem; color:var(--faint); margin-top:.4rem; }
  .switch a { color:var(--accent); cursor:pointer; text-decoration:none; }
  .switch a:hover { text-decoration:underline; }
  .cursor { display:inline-block; width:.5em; }
</style>
</head>
<body>
<main>
  <h1><a href="/">Ask</a> <span style="color:var(--faint);font-weight:400">· homelab wiki</span></h1>
  <form id="f">
    <input id="q" name="q" placeholder="Search, or ask a question, across work, knowledge base and personal notes…"
           autocomplete="off" autofocus>
    <button type="submit">Go</button>
  </form>
  <div class="status" id="s"></div>
  <div id="chat"></div>
  <ul id="r"></ul>
  <footer>
    Keyword + meaning, fused, and questions answered from it. Results link into
    <a href="{{ vaultask_wiki_base }}">the wiki</a>.
  </footer>
</main>
<script>
const f=document.getElementById('f'), q=document.getElementById('q'),
      s=document.getElementById('s'), r=document.getElementById('r'),
      chat=document.getElementById('chat');
const esc=t=>(t||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

// Conversation kept client-side only (nothing persists across a reload);
// the server independently caps how much of it a prompt actually uses
// (vaultask_history_turns) — see server.mjs's trimHistory.
let chatHistory = [];

// ---- pure search: unchanged data path (/api/search), unchanged rendering ----
async function run(term){
  if(!term) return;
  s.textContent='Searching…'; r.innerHTML='';
  history.replaceState(null,'', '?q='+encodeURIComponent(term));
  try{
    const res=await fetch('/api/search?q='+encodeURIComponent(term));
    const d=await res.json();
    if(d.error){ s.textContent='Error: '+d.error; return; }
    s.innerHTML = d.results.length
      ? esc(d.results.length+' of '+d.total+' notes')
        + (d.degraded ? ' <span class="warn">· semantic search unavailable, keyword only</span>' : '')
      : 'No matches.';
    r.innerHTML = d.results.map(x=>`
      <li>
        <div class="t">
          <a href="${esc(x.url)}">${esc(x.title)}</a>
          <span class="topic">${esc(x.topic)}</span>
          <span class="why">${esc(x.matched.join(' + '))}</span>
        </div>
        ${x.snippet?`<div class="snip">${x.snippet}</div>`:''}
        ${x.tags&&x.tags.length?`<div class="tags">${x.tags.map(esc).join(' · ')}</div>`:''}
      </li>`).join('');
  }catch(e){ s.textContent='Error: '+e.message; }
}

// ---- ask: streamed chat over /api/ask, SSE parsed by hand (no deps) ----
function addUserBubble(term){
  const el=document.createElement('div');
  el.className='msg user';
  el.innerHTML=`<div class="label">You</div>${esc(term)}`;
  chat.appendChild(el);
  return el;
}

function addAssistantBubble(){
  const el=document.createElement('div');
  el.className='msg assistant';
  el.innerHTML=`<div class="badge-slot"></div><div class="answer"></div><div class="cites-slot"></div><div class="switch-slot"></div>`;
  chat.appendChild(el);
  return el;
}

function renderBadge(el, grounded){
  el.querySelector('.badge-slot').innerHTML = grounded
    ? `<span class="badge wiki">answered from the wiki</span>`
    : `<span class="badge general">answered from general knowledge — not from your notes</span>`;
}

function renderCites(el, sources){
  const slot = el.querySelector('.cites-slot');
  if(!sources || !sources.length){ slot.innerHTML=''; return; }
  slot.innerHTML = `<div class="cites">Sources<ol>${sources.map(src=>
    `<li><a href="${esc(src.url)}" target="_blank" rel="noopener">[${src.n}] ${esc(src.title)}</a></li>`
  ).join('')}</ol></div>`;
}

function renderSwitch(el, term, mode){
  el.querySelector('.switch-slot').innerHTML = `<div class="switch">` +
    (mode==='ask' ? `<a data-mode="search">Search instead</a>` : `<a data-mode="ask">Ask instead</a>`) +
    `</div>`;
  el.querySelector('.switch-slot a').addEventListener('click', ()=>ask(term, el.querySelector('.switch-slot a').dataset.mode));
}

async function ask(term, forceMode){
  if(!term) return;
  history.replaceState(null,'', '?q='+encodeURIComponent(term));
  s.textContent = forceMode==='search' ? 'Searching…' : (forceMode==='ask' ? 'Asking…' : 'Thinking…');
  r.innerHTML='';
  let res;
  try{
    res = await fetch('/api/ask', {
      method:'POST',
      headers:{'content-type':'application/json'},
      body: JSON.stringify({ query: term, mode: forceMode, history: chatHistory }),
    });
  }catch(e){ s.textContent='Error: '+e.message; return; }
  if(!res.ok || !res.body){ s.textContent='Error: '+res.status; return; }

  const reader=res.body.getReader(), decoder=new TextDecoder();
  let buf='', bubble=null, answerText='', sawSearch=false;
  const cursor=()=>bubble && (bubble.querySelector('.answer').innerHTML = esc(answerText)+'<span class="cursor">▌</span>');

  while(true){
    const {done, value} = await reader.read();
    if(done) break;
    buf += decoder.decode(value, {stream:true});
    let idx;
    while((idx = buf.indexOf('\n\n')) >= 0){
      const line = buf.slice(0, idx).trim();
      buf = buf.slice(idx+2);
      if(!line.startsWith('data:')) continue;
      let evt; try{ evt = JSON.parse(line.slice(5).trim()); }catch{ continue; }

      if(evt.type === 'mode' && evt.mode === 'search'){
        // The heuristic (or an explicit override) decided this is a lookup,
        // not a question — fall back to the existing rich search rendering
        // instead of a plainer citations list for the same notes.
        sawSearch = true;
        s.textContent='';
        // Awaited so the switch link is appended AFTER run() finishes
        // setting s.innerHTML from the search results — otherwise the
        // later innerHTML assignment would silently wipe it out.
        await run(term);
        renderSwitchAfterSearch(term);
        return;
      }
      if(evt.type === 'mode' && evt.mode === 'ask'){
        s.textContent='';
        addUserBubble(term);
        bubble = addAssistantBubble();
        renderBadge(bubble, evt.grounded);
      }
      if(evt.type === 'sources' && bubble){
        renderCites(bubble, evt.sources);
      }
      if(evt.type === 'token'){
        answerText += evt.text;
        cursor();
      }
      if(evt.type === 'done'){
        if(bubble) bubble.querySelector('.answer').textContent = answerText;
        if(!sawSearch){
          chatHistory.push({role:'user', content: term});
          chatHistory.push({role:'assistant', content: answerText});
          if(bubble) renderSwitch(bubble, term, 'ask');
        }
      }
      if(evt.type === 'error'){
        s.textContent = 'Error: '+evt.error;
      }
    }
  }
}

// Offered after a plain search result, so a keyword-shaped query that was
// really a question can still get a grounded answer without retyping it.
// Appended under the status line, not into #chat — a fallback to search
// produced no chat turn, so there is nothing there to attach it to.
function renderSwitchAfterSearch(term){
  const el=document.createElement('span');
  el.className='switch';
  el.innerHTML=` · <a>Ask instead</a>`;
  el.querySelector('a').addEventListener('click', ()=>ask(term, 'ask'));
  s.appendChild(el);
}

f.addEventListener('submit', e=>{ e.preventDefault(); ask(q.value.trim()); });
// Support ?q= so the dashboard search box can link straight here.
const initial=new URLSearchParams(location.search).get('q');
if(initial){ q.value=initial; ask(initial); }
</script>
</body>
</html>
