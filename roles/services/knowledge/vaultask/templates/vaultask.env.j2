# Managed by Ansible — services/knowledge/vaultask
#
# Carries VAULTASK_LLM_API_KEY (== omlx_api_key) in clear. This file MUST
# stay mode 0600 and the templating task MUST stay no_log: true —
# ops/gitops_executor runs `site.yml --check --diff` on a timer and writes
# the output to a log file, so a diffed secret would otherwise be persisted
# there. Same pattern, same reason, as
# roles/services/ai/researchd/templates/researchd.env.j2.
VAULTASK_LLM_API_KEY={{ omlx_api_key }}
