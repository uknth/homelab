// Managed by Ansible — services/knowledge/vaultask
//
// Search over the merged wiki. Hybrid: SQLite FTS5 (BM25) for lexical matches,
// cosine over note embeddings for semantic ones, fused with Reciprocal Rank
// Fusion.
//
// Also answers questions, grounded in that same retrieval: /api/ask runs the
// retrieval below, hands the top notes to an LLM as the only source it is
// allowed to answer from, and streams the reply back with citations. /api/
// search stays pure retrieval, unchanged — no LLM involved on that path.
import fs from "fs"
import path from "path"
import http from "http"
import { DatabaseSync } from "node:sqlite"

const MERGED = "/merged"
const DATA = "/data"
const PORT = {{ vaultask_port }}
const N_RESULTS = {{ vaultask_results }}
const RRF_K = {{ vaultask_rrf_k }}
// Cosine below which retrieval is treated as having found nothing relevant.
// Measured against this corpus rather than guessed: genuinely on-topic queries
// score 0.82-0.86, deliberate nonsense 0.54-0.60. bge-small never returns
// anything near zero for unrelated text, so "did we get results" is useless as
// a relevance test — the index always returns its 20 best, however bad.
const GROUND_MIN = {{ vaultask_ground_threshold }}
const WIKI = {{ vaultask_wiki_base | to_json }}
const EMBED = "http://{{ vaultask_embed_host }}:{{ vaultask_embed_port }}"

// omlx on ai01: always resident, unlike vaultindex-llm on cmp01 which sits
// behind an `ondemand` compose profile (started/stopped per use) and would
// otherwise compete with Jellyfin for cmp01's A4000 every time someone asked
// a question. Reached over the `default` bridge network, NOT the `ai`
// network also joined below — that one has no route off the host.
const LLM_BASE_URL = {{ vaultask_llm_base_url | to_json }}
const LLM_MODEL = {{ vaultask_llm_model | to_json }}
// Never baked into this file (world-readable, 0644): it comes in only
// through the container's environment, from a 0600 env file templated with
// no_log: true. See templates/vaultask.env.j2.
const LLM_API_KEY = process.env.VAULTASK_LLM_API_KEY || ""

const ANSWER_NOTES = {{ vaultask_answer_notes }}
const NOTE_CHARS = {{ vaultask_note_chars }}
const HISTORY_TURNS = {{ vaultask_history_turns }}

// ---------------------------------------------------------------- index ----
let db = null
let vectors = {}
let meta = new Map()
let builtAt = 0

const stripFm = (t) => {
  if (!t.startsWith("---")) return { fm: "", body: t }
  const e = t.indexOf("\n---", 3)
  return e < 0 ? { fm: "", body: t } : { fm: t.slice(4, e), body: t.slice(e + 4) }
}

// Same shape of cleanup the enricher does: link syntax and fences carry no
// meaning for retrieval and would otherwise pollute both BM25 and snippets.
const plain = (t) =>
  t
    .replace(/^[ \t]*(`{3,}|~{3,})[\s\S]*?^[ \t]*\1[ \t]*$/gm, " ")
    .replace(/!\[\[[^\]]*\]\]/g, " ")
    .replace(/\[\[([^\]|]*)\|?([^\]]*)\]\]/g, (m, a, b) => b || a)
    .replace(/https?:\/\/\S+/g, " ")
    .replace(/[#*_>|`]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()

function walk(dir, base = dir, out = []) {
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    if (e.name.startsWith(".")) continue
    const fp = path.join(dir, e.name)
    if (e.isDirectory()) walk(fp, base, out)
    else if (e.isFile() && e.name.endsWith(".md")) out.push(path.relative(base, fp))
  }
  return out
}

function buildIndex() {
  const t0 = Date.now()
  db = new DatabaseSync(":memory:")
  // `unindexed` on rel/title/topic keeps them retrievable without diluting BM25
  // scoring, which should reflect the body only.
  db.exec(`CREATE VIRTUAL TABLE notes USING fts5(
    rel UNINDEXED, title, topic UNINDEXED, body, tokenize='porter unicode61'
  )`)
  const ins = db.prepare("INSERT INTO notes(rel,title,topic,body) VALUES(?,?,?,?)")
  meta = new Map()

  for (const rel of walk(MERGED)) {
    const raw = fs.readFileSync(path.join(MERGED, rel), "utf8")
    const { fm, body } = stripFm(raw)
    const title = path.basename(rel, ".md")
    const topic = rel.split("/")[0]
    const text = plain(body)
    ins.run(rel, title, topic, text)
    meta.set(rel, {
      title,
      topic,
      tags: (/tags:([\s\S]{0,200})/.exec(fm)?.[1] || "")
        .split("\n")
        .map((l) => (/^\s*-\s*(.+?)\s*$/.exec(l) || [])[1])
        .filter(Boolean)
        .slice(0, 6),
      chars: text.length,
    })
  }

  try {
    vectors = JSON.parse(fs.readFileSync(path.join(DATA, "vectors.json"), "utf8"))
  } catch {
    vectors = {} // enrichment has not run yet; lexical search still works
  }
  builtAt = Date.now()
  console.log(`indexed ${meta.size} notes, ${Object.keys(vectors).length} vectors in ${builtAt - t0}ms`)
}

// The merged tree is rebuilt by the hourly ingest; pick that up without a
// restart by watching the enricher's output, which is written last.
function maybeRebuild() {
  let stamp = 0
  for (const f of [path.join(DATA, "vectors.json"), MERGED]) {
    try { stamp = Math.max(stamp, fs.statSync(f).mtimeMs) } catch {}
  }
  if (stamp > builtAt) buildIndex()
}

// --------------------------------------------------------------- search ----
async function embedQuery(q) {
  const r = await fetch(`${EMBED}/embedding`, {
    method: "POST",
    headers: { "content-type": "application/json" },
    body: JSON.stringify({ content: q }),
  })
  if (!r.ok) throw new Error(`embed ${r.status}`)
  const j = await r.json()
  const v = Array.isArray(j) ? j[0]?.embedding : j.embedding
  const vec = Array.isArray(v?.[0]) ? v[0] : v
  const m = Math.sqrt(vec.reduce((s, x) => s + x * x, 0)) || 1
  return vec.map((x) => x / m)
}

// FTS5 treats bare punctuation as syntax; quote each term so a query like
// "kubernetes: what?" cannot produce a parse error instead of results.
const ftsQuery = (q) =>
  q
    .split(/\s+/)
    .map((t) => t.replace(/["*]/g, "").trim())
    .filter(Boolean)
    .map((t) => `"${t}"*`)
    .join(" OR ")

function lexical(q) {
  const expr = ftsQuery(q)
  if (!expr) return []
  try {
    return db
      .prepare(
        `SELECT rel, snippet(notes, 3, '<mark>', '</mark>', '…', 24) AS snip, bm25(notes) AS score
         FROM notes WHERE notes MATCH ? ORDER BY score LIMIT 60`,
      )
      .all(expr)
  } catch (e) {
    console.error("fts error:", e.message)
    return []
  }
}

function semantic(qv) {
  const out = []
  for (const [rel, v] of Object.entries(vectors)) {
    let d = 0
    for (let i = 0; i < v.length; i++) d += qv[i] * v[i]
    out.push({ rel, score: d })
  }
  out.sort((a, b) => b.score - a.score)
  return out.slice(0, 60)
}

// RRF: rank-based, so the two scales (BM25 is negative-lower-better, cosine is
// 0..1) never have to be made comparable.
function fuse(lex, sem) {
  const acc = new Map()
  const add = (rel, rank, which) => {
    const e = acc.get(rel) || { rel, score: 0, in: [] }
    e.score += 1 / (RRF_K + rank)
    e.in.push(which)
    acc.set(rel, e)
  }
  lex.forEach((r, i) => add(r.rel, i + 1, "keyword"))
  sem.forEach((r, i) => add(r.rel, i + 1, "meaning"))
  return [...acc.values()].sort((a, b) => b.score - a.score)
}

const slug = (rel) =>
  rel.replace(/\.md$/i, "").split("/").map((s) => encodeURIComponent(s.replace(/ /g, "-"))).join("/")

// The fused ranking, shared by /api/search and the ask-side retrieval below,
// so the two never drift into ranking notes differently for the same query.
async function retrieve(q) {
  maybeRebuild()
  const lex = lexical(q)
  let sem = []
  let semError = null
  try {
    if (Object.keys(vectors).length) sem = semantic(await embedQuery(q))
  } catch (e) {
    // Lexical results are still worth returning if the embedding server is down.
    semError = e.message
  }
  const snips = new Map(lex.map((r) => [r.rel, r.snip]))
  // Best raw cosine, kept alongside the fused ranking because RRF throws the
  // scores away — it fuses RANKS. Rank alone cannot answer "is the top hit
  // actually about this?", which is exactly what the ask path has to decide.
  const topCosine = sem.length ? sem[0].score : null
  return { fused: fuse(lex, sem), snips, semError, topCosine }
}

async function search(q) {
  const { fused, snips, semError } = await retrieve(q)
  return {
    query: q,
    degraded: semError,
    total: meta.size,
    results: fused
      .slice(0, N_RESULTS)
      .map((r) => {
        const m = meta.get(r.rel) || {}
        return {
          title: m.title,
          topic: m.topic,
          tags: m.tags,
          url: `${WIKI}/${slug(r.rel)}`,
          matched: [...new Set(r.in)],
          snippet: snips.get(r.rel) || "",
        }
      }),
  }
}

// --------------------------------------------------------------- routing ---
// Deterministic and explainable on purpose: which of "search" (return notes)
// or "ask" (generate a grounded answer) a query gets is a regex away, and
// spending an LLM call to decide that would be slower for no better an
// answer. Explicit `mode` from the client always wins over the heuristic.
const ASK_WORDS = new Set([
  "what", "why", "how", "when", "where", "who", "which",
  "is", "are", "do", "does", "can", "should",
  "explain", "summarise", "summarize", "compare", "tell",
])

function decideMode(query, explicit) {
  if (explicit === "search" || explicit === "ask") return explicit
  const q = (query || "").trim()
  if (!q) return "search"
  if (q.endsWith("?")) return "ask"
  const words = q.split(/\s+/).filter(Boolean)
  const first = (words[0] || "").toLowerCase().replace(/[^a-z]/g, "")
  if (ASK_WORDS.has(first)) return "ask"
  if (words.length >= 6) return "ask"
  return "search"
}

// ------------------------------------------------------------- grounding ---
// Same `rel` path the merge tree uses, so this reads exactly the file the
// index was built from — no separate copy of note text to keep in sync.
function readNoteText(rel) {
  try {
    const raw = fs.readFileSync(path.join(MERGED, rel), "utf8")
    const { body } = stripFm(raw)
    return body.trim().slice(0, NOTE_CHARS)
  } catch {
    return ""
  }
}

// Top ANSWER_NOTES of the same fused ranking /api/search uses, with the full
// (truncated) note body attached for the prompt. An empty array here is what
// tells the caller retrieval found nothing — the signal `grounded` is built on.
async function retrieveForAsk(q) {
  const { fused, snips, topCosine } = await retrieve(q)
  // No semantic signal at all (embedder down, or enrichment has not run) ->
  // ground anyway. Answering from the notes we do have, with citations a
  // reader can check, beats free-associating from model memory.
  const grounded = topCosine === null ? fused.length > 0 : topCosine >= GROUND_MIN
  const notes = fused.slice(0, ANSWER_NOTES).map((r, i) => {
    const m = meta.get(r.rel) || {}
    return {
      n: i + 1,
      title: m.title,
      url: `${WIKI}/${slug(r.rel)}`,
      snippet: snips.get(r.rel) || "",
      text: readNoteText(r.rel),
    }
  })
  return { notes, grounded, topCosine }
}

const GROUNDED_SYSTEM =
  "You are the assistant for a personal home wiki. Answer the user's " +
  "question using ONLY the numbered notes provided below — do not draw on " +
  "outside knowledge. Cite every claim with the matching bracketed marker, " +
  "e.g. [1], [2]. If the notes do not contain the answer, say so plainly " +
  "rather than filling the gap yourself."

// There is deliberately NO ungrounded system prompt any more.
//
// This service answers from the wiki or it does not answer. It used to fall
// back to the model's general knowledge, clearly labelled — but general
// questions now belong to ask.{{ base_domain }}, which is a separate service
// with no wiki data at all. Keeping a general-knowledge path here would blur
// the boundary that split them: THIS host holds the notes (including
// Secrets/ and Finances/) and never talks to a third-party model; THAT host
// may talk to one and never holds the notes. A fallback here would be the
// crack that boundary leaks through.

// Last HISTORY_TURNS entries only, and only the shape a chat message needs —
// the client's `history` is untrusted input, not something to pass through.
function trimHistory(history) {
  if (!Array.isArray(history)) return []
  return history
    .filter((h) => h && (h.role === "user" || h.role === "assistant") && typeof h.content === "string")
    .slice(-HISTORY_TURNS)
    .map((h) => ({ role: h.role, content: h.content }))
}

function buildAskMessages(query, notes, history) {
  // `notes` is never empty here: the caller refuses an unmatched query before
  // the model is ever reached, so there is no ungrounded branch to take.
  const notesBlock = notes.map((n) => `[${n.n}] ${n.title} (${n.url})\n${n.text}`).join("\n\n")
  const user = `Numbered notes:\n\n${notesBlock}\n\nQuestion: ${query}`
  return [
    { role: "system", content: GROUNDED_SYSTEM },
    ...history,
    { role: "user", content: user },
  ]
}

// Streams omlx's chat/completions, forwarding each token delta to `onToken`
// as it arrives — a chat window that blocks for the full 20s+ generation
// would be a bad chat window. No SDK: this is a stdlib fetch reading an SSE
// body by hand, same dependency-free posture as the rest of this file.
async function streamAnswer(messages, onToken) {
  const r = await fetch(`${LLM_BASE_URL}/chat/completions`, {
    method: "POST",
    headers: {
      "content-type": "application/json",
      authorization: `Bearer ${LLM_API_KEY}`,
    },
    body: JSON.stringify({ model: LLM_MODEL, messages, stream: true, temperature: 0.2 }),
  })
  if (!r.ok || !r.body) {
    const detail = await r.text().catch(() => "")
    throw new Error(`omlx ${r.status}: ${detail.slice(0, 300)}`)
  }
  const reader = r.body.getReader()
  const decoder = new TextDecoder()
  let buf = ""
  while (true) {
    const { done, value } = await reader.read()
    if (done) break
    buf += decoder.decode(value, { stream: true })
    let idx
    while ((idx = buf.indexOf("\n\n")) >= 0) {
      const line = buf.slice(0, idx).trim()
      buf = buf.slice(idx + 2)
      if (!line.startsWith("data:")) continue
      const data = line.slice(5).trim()
      if (data === "[DONE]") return
      let obj
      try {
        obj = JSON.parse(data)
      } catch {
        continue // a partial/malformed frame is skipped, not fatal to the stream
      }
      const delta = obj?.choices?.[0]?.delta?.content
      if (delta) onToken(delta)
    }
  }
}

// ------------------------------------------------------------------- ui ----
const UI = fs.readFileSync("/app/index.html", "utf8")

http
  .createServer(async (req, res) => {
    const u = new URL(req.url, "http://x")
    if (u.pathname === "/api/search") {
      const q = (u.searchParams.get("q") || "").trim()
      if (!q) {
        res.writeHead(400, { "content-type": "application/json" })
        return res.end(JSON.stringify({ error: "missing q" }))
      }
      try {
        const out = await search(q)
        res.writeHead(200, { "content-type": "application/json" })
        return res.end(JSON.stringify(out))
      } catch (e) {
        res.writeHead(500, { "content-type": "application/json" })
        return res.end(JSON.stringify({ error: e.message }))
      }
    }
    if (u.pathname === "/api/ask" && req.method === "POST") {
      let raw = ""
      req.on("data", (c) => (raw += c))
      req.on("end", async () => {
        let payload
        try {
          payload = JSON.parse(raw || "{}")
        } catch {
          payload = {}
        }
        const query = (payload.query || "").trim()
        if (!query) {
          res.writeHead(400, { "content-type": "application/json" })
          return res.end(JSON.stringify({ error: "missing query" }))
        }
        const mode = decideMode(query, payload.mode)

        res.writeHead(200, {
          "content-type": "text/event-stream",
          "cache-control": "no-cache",
          connection: "keep-alive",
        })
        const send = (obj) => res.write(`data: ${JSON.stringify(obj)}\n\n`)

        // "search" here is the same fused ranking /api/search returns — this
        // endpoint is a superset of it, not a different retrieval, so a query
        // the heuristic reads as a lookup still gets the rich result list
        // rather than a worse, LLM-shaped view of the same notes.
        if (mode === "search") {
          try {
            const out = await search(query)
            send({ type: "mode", mode: "search" })
            send({
              type: "sources",
              sources: out.results.map((r, i) => ({ n: i + 1, title: r.title, url: r.url, snippet: r.snippet })),
            })
            send({ type: "done" })
          } catch (e) {
            send({ type: "error", error: e.message })
          }
          return res.end()
        }

        // mode === "ask"
        try {
          const { notes, grounded, topCosine } = await retrieveForAsk(query)
          send({ type: "mode", mode: "ask", grounded })
          console.log(`ask: grounded=${grounded} topCosine=${topCosine === null ? "n/a" : topCosine.toFixed(3)} q=${JSON.stringify(query.slice(0, 80))}`)

          // Nothing in the wiki matched -> say so and stop. This service
          // answers from the notes or not at all; general questions belong to
          // ask.{{ base_domain }}, which has no wiki data. The sources are
          // still sent so a reader can see WHAT retrieval returned and judge
          // the miss for themselves rather than being told to trust it.
          if (!grounded) {
            send({
              type: "sources",
              sources: notes.map((n) => ({ n: n.n, title: n.title, url: n.url, snippet: n.snippet })),
            })
            send({
              type: "token",
              text: "Nothing in the wiki covers this. The closest notes are listed below — "
                + "if none of them are what you meant, try different words, or ask at "
                + "ask.{{ base_domain }} for a general answer.",
            })
            send({ type: "done" })
            return res.end()
          }

          send({
            type: "sources",
            sources: notes.map((n) => ({ n: n.n, title: n.title, url: n.url, snippet: n.snippet })),
          })
          const messages = buildAskMessages(query, notes, trimHistory(payload.history))
          await streamAnswer(messages, (text) => send({ type: "token", text }))
          send({ type: "done" })
        } catch (e) {
          // Down LLM (or a malformed reply) ends the stream with an error
          // event, not an HTTP 500 — the response is already 200 and
          // text/event-stream by this point, and search on this same query
          // is unaffected: it never depends on omlx at all.
          send({ type: "error", error: e.message })
        }
        res.end()
      })
      return
    }
    if (u.pathname === "/healthz") {
      res.writeHead(200, { "content-type": "application/json" })
      return res.end(JSON.stringify({ ok: true, notes: meta.size, vectors: Object.keys(vectors).length }))
    }
    res.writeHead(200, { "content-type": "text/html; charset=utf-8" })
    res.end(UI)
  })
  .listen(PORT, "0.0.0.0", () => {
    buildIndex()
    console.log(`vaultask listening on ${PORT}`)
  })
