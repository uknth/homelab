# Managed by Ansible — services/knowledge/vaultsync. Mode 0600, never in git.
# Sourced by vault-ingest.sh. One end-to-end encryption password per vault:
# each remote vault has its own key, so these are not interchangeable.
{% for v in vaultsync_vaults %}
PW_{{ v.name }}={{ (v.password | default('', true)) | quote }}
{% endfor %}
