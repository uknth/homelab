#!/usr/bin/env bash
# Managed by Ansible — services/knowledge/vaultmerge. Runs on cmp01.
# Called by vault-ingest.sh between the sync and the wiki build.
set -uo pipefail
export LANG=C.UTF-8 LC_ALL=C.UTF-8

if ! docker ps --format '{% raw %}{{.Names}}{% endraw %}' | grep -qx vaultmerge; then
  echo "vaultmerge container is not running" >&2
  exit 1
fi

exec docker exec -u {{ vaultmerge_uid }}:{{ vaultmerge_gid }} vaultmerge \
  node /app/merge-vaults.mjs /vaults /merged
