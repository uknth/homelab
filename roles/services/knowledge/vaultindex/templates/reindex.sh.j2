#!/usr/bin/env bash
# Managed by Ansible — services/knowledge/vaultindex. Runs on cmp01.
# Called by vault-ingest.sh after the merge and before the wiki build.
#
# The summary model is ~6.8 GiB of VRAM and this job is idle almost every hour,
# so it is started ON DEMAND and only when notes actually need summarising —
# the A4000 keeps its headroom for Jellyfin and Paperless the rest of the time.
# The embedding model is ~36 MiB and stays up; cycling it would cost more than
# it saves.
set -uo pipefail
export LANG=C.UTF-8 LC_ALL=C.UTF-8

COMPOSE="{{ vaultindex_root_dir }}/compose/docker-compose.yml"
# -p is required, not cosmetic: without it compose derives the project name from
# the file's parent directory ("compose"), creating a SEPARATE `compose_ai`
# network. The on-demand model would come up isolated from the worker and every
# request would fail with "fetch failed".
PROJECT="vaultindex"

# This script owns a SHARED resource — it starts and stops the summary model
# container — so it needs its own lock, not just the one in vault-ingest.sh.
# Without it, two concurrent runs race: the first to finish stops the model in
# its trap while the second is still mid-run, and every remaining request dies
# with "fetch failed". That is exactly what happened on 2026-09-01, losing ~300
# summaries. Degrades to unlocked if flock is missing, because never running is
# worse than overlapping.
if command -v flock >/dev/null 2>&1; then
  exec 8>"{{ vaultindex_root_dir }}/.reindex.lock"
  if ! flock -n 8; then
    echo "another enrichment run is already in progress — skipping" >&2
    exit 0
  fi
fi
LLM_STARTED=0

# Whatever happens — success, failure, or Ctrl-C — the big model comes back
# down. Leaking 6.8 GiB of VRAM on a failed run is the thing to avoid.
cleanup() {
  if [ "$LLM_STARTED" = "1" ]; then
    echo "stopping the summary model"
    docker compose -p "$PROJECT" -f "$COMPOSE" stop vaultindex-llm >/dev/null 2>&1
  fi
}
trap cleanup EXIT INT TERM

for c in vaultindex vaultindex-embed; do
  if ! docker ps --format '{% raw %}{{.Names}}{% endraw %}' | grep -qx "$c"; then
    echo "$c is not running" >&2
    exit 1
  fi
done

wait_healthy() {  # $1 host, $2 port, $3 tries
  for i in $(seq 1 "$3"); do
    if docker exec vaultindex node -e "
      fetch('http://$1:$2/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))
    " 2>/dev/null; then return 0; fi
    sleep 5
  done
  return 1
}

wait_healthy vaultindex-embed {{ vaultindex_embed_port }} 24 || {
  echo "embedding server never became healthy" >&2; exit 1; }

# Cheap, local, no model involved: just hashes against the cache.
NEED=$(docker exec -u {{ vaultindex_uid }}:{{ vaultindex_gid }} vaultindex \
       node /app/enrich.mjs --check /merged /data 2>/dev/null | tail -1)
NEED=${NEED:-0}
echo "notes needing a summary: $NEED"

if [ "$NEED" -gt 0 ] 2>/dev/null; then
  echo "starting the summary model ({{ vaultindex_llm_model_file }})"
  docker compose -p "$PROJECT" -f "$COMPOSE" --profile ondemand up -d vaultindex-llm || exit 1
  LLM_STARTED=1
  # A 6.8 GiB model takes a while to load onto the card from cold.
  wait_healthy vaultindex-llm {{ vaultindex_llm_port }} 60 || {
    echo "summary model never became healthy" >&2; exit 1; }
  docker exec -u {{ vaultindex_uid }}:{{ vaultindex_gid }} vaultindex \
    node /app/enrich.mjs /merged /data
  RC=$?
else
  # Nothing to summarise: refresh embeddings and related links only, and never
  # spin up the big model at all.
  docker exec -u {{ vaultindex_uid }}:{{ vaultindex_gid }} vaultindex \
    node /app/enrich.mjs --no-llm /merged /data
  RC=$?
fi

exit $RC
