# Managed by Ansible — services/productivity/tickets
services:
  tickets:
    image: {{ tickets_image }}
    container_name: tickets
    hostname: tickets
    restart: unless-stopped
    init: true
    user: "{{ tickets_uid }}:{{ tickets_gid }}"
    environment:
      - TZ={{ timezone }}
      - NODE_NO_WARNINGS=1
    # The Gitea bot token lives ONLY here, never inline under `environment:`
    # above — that block lands verbatim in `docker inspect`, an env_file
    # does not. Same posture as vaultask's compose (roles/services/knowledge/
    # vaultask/templates/docker-compose.yml.j2) and researchd's.
    env_file:
      - tickets.env
    volumes:
      - {{ tickets_root_dir }}/app:/app:ro
      # The only state this service owns: the token -> issue lookup table.
      - {{ tickets_data_dir }}:/data
    command: ["node", "/app/server.mjs"]
    ports:
      - "{{ tickets_port }}:{{ tickets_port }}"   # gw01 nginx -> help.puhome.net (no forward-auth — see hosts/host_vars/gw01/vars.yml)
