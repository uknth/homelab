<!doctype html>
<!-- Managed by Ansible — services/productivity/tickets
     This is the ONE shared HTML file: server.mjs reads it once at startup
     and, for every request, does a plain string substitution of
     __TICKETS_TITLE__ and __TICKETS_BODY__ — no templating engine, no
     client-side framework. Placeholders use double underscores rather than
     double-brace Jinja delimiters specifically so Ansible's own Jinja pass over this .j2 file never
     touches them; everything dynamic here is filled in by server.mjs at
     request time, not at deploy time. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>__TICKETS_TITLE__</title>
<style>
  :root { --bg:#faf8f8; --fg:#2b2b2b; --muted:#4e4e4e; --faint:#8a8a8a;
          --line:#e5e5e5; --accent:#284b63; --card:#fff;
          --open:#1a7f37; --done:#6e6e6e; --warn:#b45309; --warn-bg:#fdf1e0; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#161618; --fg:#ebebec; --muted:#d4d4d4; --faint:#8f8f8f;
            --line:#393639; --accent:#7b97aa; --card:#1e1e21;
            --open:#3fb950; --done:#8f8f8f; --warn:#e0a458; --warn-bg:#2c2413; }
  }
  * { box-sizing:border-box; }
  body { margin:0; padding:2.5rem 1.25rem 4rem; background:var(--bg); color:var(--fg);
         font-family:"Source Sans Pro",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  main { max-width:40rem; margin:0 auto; }
  header h1 { font-size:1.35rem; margin:0 0 1.5rem; font-weight:600; }
  header h1 a { color:inherit; text-decoration:none; }
  h2 { font-size:1.1rem; margin:0 0 .75rem; }
  a { color:var(--accent); }
  .banner { background:var(--warn-bg); color:var(--warn); border-radius:8px;
            padding:.8rem 1rem; margin-bottom:1.25rem; font-size:.92rem; }
  .error { color:#c0392b; font-size:.88rem; margin:0 0 .75rem; }

  ul.tickets { list-style:none; padding:0; margin:0 0 2rem; }
  ul.tickets li { background:var(--card); border:1px solid var(--line); border-radius:10px;
       padding:.85rem 1rem; margin-bottom:.6rem; display:flex; justify-content:space-between;
       align-items:baseline; gap:.75rem; flex-wrap:wrap; }
  ul.tickets a { font-weight:600; text-decoration:none; }
  ul.tickets a:hover { text-decoration:underline; }
  .meta { font-size:.8rem; color:var(--faint); white-space:nowrap; }
  .empty { color:var(--faint); font-size:.92rem; margin-bottom:2rem; }

  .pill { display:inline-block; font-size:.68rem; font-weight:700; letter-spacing:.03em;
          text-transform:uppercase; border-radius:99px; padding:.15rem .55rem; }
  .pill.open { background:rgba(26,127,55,.14); color:var(--open); }
  .pill.done { background:rgba(110,110,110,.16); color:var(--done); }

  form.card { background:var(--card); border:1px solid var(--line); border-radius:10px;
              padding:1.1rem 1.2rem; }
  label { display:block; font-size:.85rem; font-weight:600; margin:.9rem 0 .3rem; }
  label:first-of-type { margin-top:0; }
  input[type=text], textarea, select {
    width:100%; padding:.6rem .7rem; font-size:.95rem; border-radius:6px;
    border:1px solid var(--line); background:var(--bg); color:var(--fg);
    font-family:inherit;
  }
  input:focus, textarea:focus, select:focus { outline:2px solid var(--accent); outline-offset:-1px; }
  textarea { resize:vertical; min-height:6rem; }
  .hint { font-size:.78rem; color:var(--faint); margin-top:.25rem; }
  button { margin-top:1.1rem; padding:.7rem 1.3rem; font-size:.95rem; font-weight:600;
           border:0; border-radius:8px; background:var(--accent); color:#fff; cursor:pointer; }
  button:hover { opacity:.92; }

  .ticket-head { margin-bottom:1.25rem; }
  .ticket-head h2 { display:flex; align-items:center; gap:.6rem; flex-wrap:wrap; }
  .body-text, .comment-text { white-space:pre-wrap; line-height:1.55; }
  .body-text { background:var(--card); border:1px solid var(--line); border-radius:10px;
               padding:1rem 1.1rem; margin-bottom:1.5rem; }

  ul.comments { list-style:none; padding:0; margin:0 0 1.5rem; }
  ul.comments li { border-left:3px solid var(--line); padding:.15rem 0 .15rem 1rem; margin-bottom:1.1rem; }
  .comment-head { font-size:.8rem; color:var(--faint); margin-bottom:.3rem; }
  .comment-head strong { color:var(--fg); }

  .back { display:inline-block; margin-bottom:1.25rem; font-size:.85rem; text-decoration:none; }
  footer { margin-top:2.5rem; font-size:.78rem; color:var(--faint); }
</style>
</head>
<body>
<main>
  <header><h1><a href="/">Family Help Desk</a></h1></header>
  __TICKETS_BODY__
  <footer>Raise it here, answered in Gitea, replies show up on this page — no account needed.</footer>
</main>
</body>
</html>
