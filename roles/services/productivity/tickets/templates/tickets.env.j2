# Managed by Ansible — services/productivity/tickets
#
# Carries TICKETS_BOT_TOKEN (the ticket-bot Gitea API token) in clear. This
# file MUST stay mode 0600 and the templating task MUST stay no_log: true —
# ops/gitops_executor runs `site.yml --check --diff` on a timer and writes
# the output to a log file, so a diffed secret would otherwise be persisted
# there. Same pattern, same reason, as roles/services/ai/researchd/templates/
# researchd.env.j2 and roles/services/knowledge/vaultask/templates/
# vaultask.env.j2.
TICKETS_BOT_TOKEN={{ _tickets_bot_token }}
