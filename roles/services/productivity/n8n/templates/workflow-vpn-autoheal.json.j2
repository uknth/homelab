    {
      "parameters": {
        "jsCode": "// Same gate again after the window (user may have paused, queue may have finished),\n// then the sustained rate over the whole window. Stateless: sample A is read back\n// from this same execution, never from static data.\n\nconst st = $('Sample B status').first().json;\nconst gr = $('Sample B groups').first().json;\nconst s = st && st.result;\nconst groups = gr && Array.isArray(gr.result) ? gr.result : null;\nlet ok = false, reason = '', bytes = null;\nif (!s || !groups) {\n  reason = 'nzbget unreachable or unexpected reply';\n} else {\n  bytes = s.DownloadedSizeHi * 4294967296 + s.DownloadedSizeLo;\n  if (s.DownloadPaused) reason = 'download paused';\n  else if (s.DownloadLimit !== 0) reason = 'speed limit set';\n  else if (!(s.RemainingSizeMB > 0)) reason = 'queue empty';\n  else if (!groups.some((g) => g.Status === 'DOWNLOADING')) reason = 'no group DOWNLOADING';\n  else ok = true;\n}\nconst a = $('Sample A gate').first().json;\nconst t = Date.now();\nconst windowS = (t - a.t) / 1000;\nconst rate = ok && windowS > 0 ? (bytes - a.bytes) / windowS / 1e6 : null;\n// A negative delta means nzbget restarted mid-window (counter reset): inconclusive.\nconst slow = ok && rate !== null && rate >= 0 && rate < {% endraw %}{{ n8n_vpnheal_min_rate_mbs }}{% raw %};\nreturn [{ json: { proceed: slow, ok, reason, rate_mbs: rate === null ? null : Math.round(rate * 100) / 100, window_s: Math.round(windowS) } }];"
      },
      "id": "n-sample-b-gate",
      "name": "Sample B gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-slow-and-downloading",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.proceed }}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      },
      "id": "n-slow-and-downloading",
      "name": "Slow and downloading?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { t0: Date.now() } }];"
      },
      "id": "n-mark-isp-start",
      "name": "Mark ISP start",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1940,
        0
      ]
    },
    {
      "parameters": {
        "url": "{% endraw %}{{ n8n_vpnheal_isp_test_url }}{% raw %}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Range",
              "value": "bytes=0-{% endraw %}{{ n8n_vpnheal_isp_test_bytes - 1 }}{% raw %}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "n-isp-speed-test",
      "name": "ISP speed test",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Time the 25 MB range download. A failed/timed-out request counts as a slow ISP.\nconst t1 = Date.now();\nconst ctx = $('Sample B gate').first().json;\nconst r = $input.first().json;\nconst failed = !!r.error;\nconst secs = (t1 - $('Mark ISP start').first().json.t0) / 1000;\n// Content-Length of the ranged reply; fall back to the requested size.\nconst hdr = r.headers && (r.headers['content-length'] || r.headers['Content-Length']);\nconst bytes = hdr ? parseInt(hdr, 10) : {% endraw %}{{ n8n_vpnheal_isp_test_bytes }}{% raw %};\nconst mbps = failed || secs <= 0 ? 0 : bytes * 8 / secs / 1e6;\nconst ispOk = !failed && mbps >= {% endraw %}{{ n8n_vpnheal_isp_min_mbps }}{% raw %};\nconst rate = ctx.rate_mbs;\nconst body = failed\n  ? 'nzbget ' + rate + ' MB/s over ' + ctx.window_s + ' s. ISP speed test failed or timed out (' + (typeof r.error === 'string' ? r.error : ((r.error && r.error.message) || 'no response')) + '). Not cycling the VPN.'\n  : 'nzbget ' + rate + ' MB/s over ' + ctx.window_s + ' s. ISP only ' + mbps.toFixed(1) + ' Mbit/s (need {% endraw %}{{ n8n_vpnheal_isp_min_mbps }}{% raw %}). Not cycling the VPN.';\nreturn [{ json: { ispOk, isp_mbps: Math.round(mbps * 10) / 10, isp_failed: failed, rate_mbs: rate, window_s: ctx.window_s, isp_body: body } }];"
      },
      "id": "n-isp-result",
      "name": "ISP result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2380,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "combinator": "and",
          "conditions": [
