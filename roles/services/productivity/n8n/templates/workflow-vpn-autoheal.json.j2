        -260,
        0
      ]
    },
    {
      "parameters": {
        "url": "{% endraw %}{{ n8n_vpnheal_nzbget_url }}{% raw %}/jsonrpc/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
