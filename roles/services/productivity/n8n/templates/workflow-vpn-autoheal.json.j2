        }
      },
      "id": "n-sample-a-status",
      "name": "Sample A status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -40,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpBasicAuth": {
          "id": "homelab-nzbget",
          "name": "homelab nzbget (restricted)"
        }
      }
    },
    {
      "parameters": {
        "url": "{% endraw %}{{ n8n_vpnheal_nzbget_url }}{% raw %}/jsonrpc/listgroups",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {
          "timeout": 20000
        }
      },
      "id": "n-sample-a-groups",
      "name": "Sample A groups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpBasicAuth": {
          "id": "homelab-nzbget",
          "name": "homelab nzbget (restricted)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Is nzbget actually trying to download? If not, a slow rate means nothing.\n\nconst st = $('Sample A status').first().json;\nconst gr = $('Sample A groups').first().json;\nconst s = st && st.result;\nconst groups = gr && Array.isArray(gr.result) ? gr.result : null;\nlet ok = false, reason = '', bytes = null;\nif (!s || !groups) {\n  reason = 'nzbget unreachable or unexpected reply';\n} else {\n  bytes = s.DownloadedSizeHi * 4294967296 + s.DownloadedSizeLo;\n  if (s.DownloadPaused) reason = 'download paused';\n  else if (s.DownloadLimit !== 0) reason = 'speed limit set';\n  else if (!(s.RemainingSizeMB > 0)) reason = 'queue empty';\n  else if (!groups.some((g) => g.Status === 'DOWNLOADING')) reason = 'no group DOWNLOADING';\n  else ok = true;\n}\nreturn [{ json: { ok, reason, t: Date.now(), bytes } }];"
      },
      "id": "n-sample-a-gate",
      "name": "Sample A gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-gate-a-open",
              "operator": {
                "type": "boolean",
                "operation": "true",
