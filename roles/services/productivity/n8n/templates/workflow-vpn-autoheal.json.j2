    {
      "parameters": {
        "method": "GET",
        "url": "{% endraw %}{{ n8n_vpnheal_gluetun_url }}{% raw %}/v1/vpn/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
