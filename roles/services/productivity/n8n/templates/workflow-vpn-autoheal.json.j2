    {
      "parameters": {
        "url": "{% endraw %}{{ n8n_ntfy_url }}{% raw %}/{% endraw %}{{ n8n_jobs_ntfy_topic }}{% raw %}/json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
