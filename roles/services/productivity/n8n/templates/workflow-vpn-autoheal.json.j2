    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Count recent reconnects').first().json;\nconst errs = [];\nconst grab = (name) => { const j = $(name).first().json; return j && j.error ? j.error : null; };\nfor (const n of ['Stop VPN', 'Start VPN', 'VPN status']) {\n  const e = grab(n);\n  if (e) errs.push(n + ': ' + (e.message || JSON.stringify(e)).slice(0, 300));\n}\nconst st = $('VPN status').first().json;\nconst vpn = st && st.status ? st.status : 'unknown';\nconst body = 'nzbget ' + ctx.rate_mbs + ' MB/s over ' + ctx.window_s + ' s, ISP ' + ctx.isp_mbps + ' Mbit/s. VPN status after reconnect: ' + vpn + '.'\n  + (errs.length ? ' Errors: ' + errs.join('; ') : '');\nreturn [{ json: { report_body: body } }];"
      },
      "id": "n-build-report",
      "name": "Build report",
      "type": "n8n-nodes-base.code",
