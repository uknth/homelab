      "id": "n-vpn-status",
      "name": "VPN status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4360,
        -300
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "homelab-gluetun-control",
          "name": "homelab gluetun control API"
        }
