        "options": {
          "timeout": 20000
        }
      },
      "id": "n-sample-b-groups",
      "name": "Sample B groups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpBasicAuth": {
          "id": "homelab-nzbget",
          "name": "homelab nzbget (restricted)"
        }
      }
