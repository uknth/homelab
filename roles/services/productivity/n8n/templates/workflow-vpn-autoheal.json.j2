            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "n-fetch-reconnect-history",
      "name": "Fetch reconnect history",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2820,
        -160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// ntfy history is NDJSON; the response may arrive as one string (or, defensively,\n// as already-parsed objects). Count message events carrying the reconnect tag.\nconst ctx = $('ISP result').first().json;\nconst items = $input.all();\nlet lines = [];\nlet fetchFailed = false;\nfor (const it of items) {\n  const j = it.json || {};\n  if (j.error) { fetchFailed = true; continue; }\n  const d = j.data !== undefined ? j.data : j;\n  if (typeof d === 'string') lines = lines.concat(d.split('\\n'));\n  else if (d && typeof d === 'object') lines.push(JSON.stringify(d));\n}\nlet count = 0;\nfor (const line of lines) {\n  if (!line.trim()) continue;\n  try { if (JSON.parse(line).event === 'message') count++; } catch (e) { /* ignore partial lines */ }\n}\n// If history cannot be read the rate limit cannot be enforced -- fail safe.\nconst limited = fetchFailed || count >= {% endraw %}{{ n8n_vpnheal_max_per_hour }}{% raw %};\nconst body = 'nzbget ' + ctx.rate_mbs + ' MB/s over ' + ctx.window_s + ' s, ISP ' + ctx.isp_mbps + ' Mbit/s. '\n  + (fetchFailed ? 'Could not read ntfy history to check the rate limit.' : count + ' reconnect(s) in the last hour (max {% endraw %}{{ n8n_vpnheal_max_per_hour }}{% raw %}).')\n  + ' Check the VPN by hand.';\nreturn [{ json: Object.assign({}, ctx, { reconnects_last_hour: count, limited, limit_body: body }) }];"
      },
      "id": "n-count-recent-reconnects",
      "name": "Count recent reconnects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3040,
        -160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-limit-reached",
              "operator": {
                "type": "boolean",
                "operation": "true",
