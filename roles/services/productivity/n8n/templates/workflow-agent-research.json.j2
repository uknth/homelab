{
  "id": "homelab-agent-research",
  "name": "Homelab — agent research (researchd → wiki)",
  "active": true,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": {{ n8n_research_poll_minutes }} }
          ]
        }
      },
      "id": "n-cron",
      "name": "Poll interval",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-260, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "{{ n8n_research_api_url }}/api/jobs",
        "options": {}
      },
      "id": "n-fetch",
      "name": "Fetch job list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-status",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={% raw %}{{ $json.status }}{% endraw %}",
              "rightValue": "ready"
            }
          ]
        },
        "options": {}
      },
      "id": "n-filter",
      "name": "Ready jobs",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [180, 0]
    },
    {
      "parameters": { "jsCode": "// Skips any job whose ingest is still in flight. The API keeps reporting\n// `ready` for a job on every poll until researchd's /published callback\n// runs, and the SSH ingest (pull + vaultmerge + vaultindex + Quartz rebuild)\n// takes ~20 minutes -- well over the poll interval -- so without this guard\n// the same job gets ingested several times concurrently. Marked in-flight\n// here; cleared by 'Clear in-flight' once this job's run reaches Mark\n// published or the failure branch.\nconst sd = $getWorkflowStaticData('global');\nconst inFlight = sd.researchInFlight || (sd.researchInFlight = {});\nconst items = $input.all();\nconst out = [];\nfor (const item of items) {\n  const id = item.json.id;\n  if (inFlight[id]) continue;\n  inFlight[id] = true;\n  out.push(item);\n}\nreturn out;" },
      "id": "n-inflight",
      "name": "Skip in-flight jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [290, 140]
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "resource": "command",
        "operation": "execute",
        "command": "=--research {% raw %}{{ $json.id }}{% endraw %}",
        "options": {}
      },
      "id": "n-ssh",
      "name": "Pull + wiki rebuild",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [400, 0],
      "onError": "continueErrorOutput",
      "credentials": {
        "sshPrivateKey": {
          "id": "homelab-vault-ssh",
          "name": "homelab vaultsync (cmp01)"
        }
      }
    },
    {
      "parameters": { "jsCode": "// One SSH node run can carry MORE than one item -- the filter can pass\n// several jobs that were 'ready' in the same poll -- so every input item\n// must produce exactly one output item here. $input.first() would silently\n// drop every job after the first the moment two land in the same poll.\n// pairedItem is set explicitly so the downstream $('Ready jobs').item\n// lookups (in Mark published / Notify research failure) still resolve the\n// correct slug/id for each branch.\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const r = items[i].json;\n  const raw = (r.stdout || '').trim();\n  // Same RESULT-marker convention as vault-ingest.sh's --all branch (the\n  // --research branch reuses write_state), so parsing is identical. Scanning\n  // for the first '{' instead would break the moment the merge/index/wiki\n  // stages it runs printed a brace of their own.\n  const line = raw.split('\\n').reverse().find((l) => l.startsWith('RESULT '));\n  let st;\n  try {\n    st = JSON.parse(line.slice(7));\n  } catch (e) {\n    st = { ok: false, error: 'research ingest returned no parseable RESULT line', code: r.code, raw: raw.slice(-400) };\n  }\n  out.push({ json: st, pairedItem: i });\n}\nreturn out;" },
      "id": "n-parse",
      "name": "Parse result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [620, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-ok",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "leftValue": "={% raw %}{{ $json.ok }}{% endraw %}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      },
      "id": "n-ok",
      "name": "Ingest ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [840, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ n8n_research_api_url }}/api/jobs/{% raw %}{{ $('Ready jobs').item.json.id }}{% endraw %}/published",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"wiki_url\": \"https://wiki.{{ base_domain }}/Agent-Research/{% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}/{% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}\"}",
        "options": {}
      },
      "id": "n-publish",
      "name": "Mark published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, -80],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ n8n_ntfy_url }}/{{ n8n_jobs_ntfy_topic }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Title", "value": "=n8n FAILED: agent research {% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}" },
            { "name": "Priority", "value": "4" },
            { "name": "Tags", "value": "n8n,books" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "={% raw %}{{ JSON.stringify($json).slice(0, 1500) }}{% endraw %}",
        "options": {}
      },
      "id": "n-fail",
      "name": "Notify research failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 160],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ n8n_ntfy_url }}/{{ n8n_jobs_ntfy_topic }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Title", "value": "=Research published: {% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}" },
            { "name": "Priority", "value": "3" },
            { "name": "Tags", "value": "n8n,books" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "=https://wiki.{{ base_domain }}/Agent-Research/{% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}/{% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}",
        "options": {}
      },
      "id": "n-notify-published",
      "name": "Notify published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, -160],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": { "jsCode": "// Ends the in-flight guard for this job's ingest run, on whichever path it\n// took -- success (via Notify published) or failure (via Notify research\n// failure). Without clearing on the failure path too, one failed ingest\n// would permanently block that job from ever being retried.\nconst sd = $getWorkflowStaticData('global');\nconst inFlight = sd.researchInFlight || (sd.researchInFlight = {});\nconst items = $input.all();\n// FAIL OPEN, deliberately. Resolving the job id here depends on the\n// pairedItem chain surviving every node between 'Ready jobs' and this one.\n// If that ever breaks, throwing would leave the guard set forever and NO\n// job would be ingested again -- the pipeline would wedge silently. Clearing\n// the whole map instead risks at worst one duplicate ingest, which is a far\n// cheaper failure than a permanent stall.\nfor (let i = 0; i < items.length; i++) {\n  try {\n    const jobId = $('Ready jobs').itemMatching(i).json.id;\n    delete inFlight[jobId];\n  } catch (e) {\n    console.log('clear-inflight: could not resolve job id, clearing all:', e.message);\n    for (const k of Object.keys(inFlight)) delete inFlight[k];\n  }\n}\nreturn items;" },
      "id": "n-clear-inflight",
      "name": "Clear in-flight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 0]
    },
    {
      "parameters": { "jsCode": "// researchd's job list has no history, only current status, so 'started'/\n// 'ready' transitions have to be derived by diffing against what this\n// workflow saw on the previous poll. Persisted in workflow static data --\n// survives across polls, reset only if the workflow is reimported.\n//\n// First execution ever (static data absent) seeds the map with NO\n// notifications: there are already ~16 historical jobs in researchd's\n// database, and without this guard enabling this workflow would fire one\n// 'started' notification per existing job.\nconst sd = $getWorkflowStaticData('global');\nconst WORKING = new Set(['queued', 'planning', 'searching', 'fetching', 'summarising', 'synthesising', 'writing']);\n\nconst seeding = sd.researchStatus === undefined;\nif (seeding) sd.researchStatus = {};\nconst prevMap = sd.researchStatus;\n\nconst items = $input.all();\nconst seenIds = new Set();\nconst out = [];\n\nfor (const item of items) {\n  const job = item.json;\n  seenIds.add(job.id);\n  const prev = prevMap[job.id];\n  prevMap[job.id] = job.status;\n\n  if (seeding || prev === job.status) continue;\n\n  if (WORKING.has(job.status) && !WORKING.has(prev || '')) {\n    out.push({ json: {\n      title: `Research started: ${job.slug}`,\n      body: `topic: ${job.topic || job.source_url || '(untitled)'} | depth ${job.depth}`,\n    } });\n  } else if (job.status === 'ready' && prev !== 'ready') {\n    out.push({ json: {\n      title: `Research ready: ${job.slug}`,\n      body: 'Markdown is ready; awaiting wiki publish.',\n    } });\n  }\n}\n\n// Prune ids the API no longer returns, so this map cannot grow without bound.\nfor (const id of Object.keys(prevMap)) {\n  if (!seenIds.has(id)) delete prevMap[id];\n}\n\nreturn out;" },
      "id": "n-track",
      "name": "Track job status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [180, -220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ n8n_ntfy_url }}/{{ n8n_jobs_ntfy_topic }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Title", "value": "={% raw %}{{ $json.title }}{% endraw %}" },
            { "name": "Priority", "value": "3" },
            { "name": "Tags", "value": "n8n,books" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "={% raw %}{{ $json.body }}{% endraw %}",
        "options": {}
      },
      "id": "n-notify-transition",
      "name": "Notify job transition",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, -220]
    }
  ],
  "connections": {
    "Poll interval": { "main": [[{ "node": "Fetch job list", "type": "main", "index": 0 }]] },
    "Fetch job list": {
      "main": [
        [
          { "node": "Ready jobs", "type": "main", "index": 0 },
          { "node": "Track job status", "type": "main", "index": 0 }
        ]
      ]
    },
    "Ready jobs": { "main": [[{ "node": "Skip in-flight jobs", "type": "main", "index": 0 }]] },
    "Skip in-flight jobs": { "main": [[{ "node": "Pull + wiki rebuild", "type": "main", "index": 0 }]] },
    "Pull + wiki rebuild": {
      "main": [
        [{ "node": "Parse result", "type": "main", "index": 0 }],
        [{ "node": "Notify research failure", "type": "main", "index": 0 }]
      ]
    },
    "Parse result": { "main": [[{ "node": "Ingest ok?", "type": "main", "index": 0 }]] },
    "Ingest ok?": {
      "main": [
        [{ "node": "Mark published", "type": "main", "index": 0 }],
        [{ "node": "Notify research failure", "type": "main", "index": 0 }]
      ]
    },
    "Mark published": {
      "main": [
        [{ "node": "Notify published", "type": "main", "index": 0 }],
        [{ "node": "Notify research failure", "type": "main", "index": 0 }]
      ]
    },
    "Notify published": {
      "main": [
        [{ "node": "Clear in-flight", "type": "main", "index": 0 }],
        [{ "node": "Clear in-flight", "type": "main", "index": 0 }]
      ]
    },
    "Notify research failure": {
      "main": [
        [{ "node": "Clear in-flight", "type": "main", "index": 0 }],
        [{ "node": "Clear in-flight", "type": "main", "index": 0 }]
      ]
    },
    "Track job status": { "main": [[{ "node": "Notify job transition", "type": "main", "index": 0 }]] }
  }
}
