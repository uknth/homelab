{
  "id": "homelab-agent-research",
  "name": "Homelab — agent research (researchd → wiki)",
  "active": true,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": {{ n8n_research_poll_minutes }} }
          ]
        }
      },
      "id": "n-cron",
      "name": "Poll interval",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-260, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "{{ n8n_research_api_url }}/api/jobs",
        "options": {}
      },
      "id": "n-fetch",
      "name": "Fetch job list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-status",
              "operator": { "type": "string", "operation": "equals" },
              "leftValue": "={% raw %}{{ $json.status }}{% endraw %}",
              "rightValue": "ready"
            }
          ]
        },
        "options": {}
      },
      "id": "n-filter",
      "name": "Ready jobs",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [180, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ n8n_research_api_url }}/api/jobs/{% raw %}{{ $json.id }}{% endraw %}/claim",
        "options": {}
      },
      "id": "n-claim",
      "name": "Claim job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [290, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "resource": "command",
        "operation": "execute",
        "command": "=--research {% raw %}{{ $json.id }}{% endraw %}",
        "options": {}
      },
      "id": "n-ssh",
      "name": "Pull + wiki rebuild",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [500, 0],
      "onError": "continueErrorOutput",
      "credentials": {
        "sshPrivateKey": {
          "id": "homelab-vault-ssh",
          "name": "homelab vaultsync (cmp01)"
        }
      }
    },
    {
      "parameters": { "jsCode": "// One SSH node run can carry MORE than one item -- the filter can pass\n// several jobs that were 'ready' in the same poll -- so every input item\n// must produce exactly one output item here. $input.first() would silently\n// drop every job after the first the moment two land in the same poll.\n// pairedItem is set explicitly so the downstream $('Ready jobs').item\n// lookups (in Mark published / Notify research failure) still resolve the\n// correct slug/id for each branch.\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const r = items[i].json;\n  const raw = (r.stdout || '').trim();\n  // Same RESULT-marker convention as vault-ingest.sh's --all branch (the\n  // --research branch reuses write_state), so parsing is identical. Scanning\n  // for the first '{' instead would break the moment the merge/index/wiki\n  // stages it runs printed a brace of their own.\n  const line = raw.split('\\n').reverse().find((l) => l.startsWith('RESULT '));\n  let st;\n  try {\n    st = JSON.parse(line.slice(7));\n  } catch (e) {\n    st = { ok: false, error: 'research ingest returned no parseable RESULT line', code: r.code, raw: raw.slice(-400) };\n  }\n  out.push({ json: st, pairedItem: i });\n}\nreturn out;" },
      "id": "n-parse",
      "name": "Parse result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-ok",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "leftValue": "={% raw %}{{ $json.ok }}{% endraw %}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      },
      "id": "n-ok",
      "name": "Ingest ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [940, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ n8n_research_api_url }}/api/jobs/{% raw %}{{ $('Ready jobs').item.json.id }}{% endraw %}/published",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"wiki_url\": \"https://wiki.{{ base_domain }}/Agent-Research/{% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}/{% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}\"}",
        "options": {}
      },
      "id": "n-publish",
      "name": "Mark published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, -80],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ n8n_ntfy_url }}/{{ n8n_jobs_ntfy_topic }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Title", "value": "=n8n FAILED: agent research {% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}" },
            { "name": "Priority", "value": "4" },
            { "name": "Tags", "value": "n8n,books" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "={% raw %}{{ JSON.stringify($json).slice(0, 1500) }}{% endraw %}",
        "options": {}
      },
      "id": "n-fail",
      "name": "Notify research failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 160],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ n8n_research_api_url }}/api/jobs/{% raw %}{{ $('Ready jobs').item.json.id }}{% endraw %}/unclaim",
        "options": {}
      },
      "id": "n-unclaim",
      "name": "Unclaim job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1380, 160],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ n8n_ntfy_url }}/{{ n8n_jobs_ntfy_topic }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Title", "value": "=Research published: {% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}" },
            { "name": "Priority", "value": "3" },
            { "name": "Tags", "value": "n8n,books" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "=https://wiki.{{ base_domain }}/Agent-Research/{% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}/{% raw %}{{ $('Ready jobs').item.json.slug }}{% endraw %}",
        "options": {}
      },
      "id": "n-notify-published",
      "name": "Notify published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1380, -160],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": { "jsCode": "// researchd's job list carries only CURRENT status + timestamps, no\n// history, and nothing is persisted in this workflow any more -- n8n\n// workflow static data does not survive here at all (confirmed live: it\n// read back empty on every run), so \"started\"/\"ready\" transitions are\n// derived from timestamps alone, fresh on every poll, instead of by\n// diffing against a remembered previous status.\n//\n// The window is 70s against a 60s poll: 10s of slack, so poll jitter or a\n// slow researchd cannot drop an event, while an event is normally seen by\n// exactly ONE poll. This started at 90s, which was wrong in practice rather\n// than in theory -- 90 > 60 means EVERY event falls inside two consecutive\n// polls, so every notification fired twice, not just occasionally (observed\n// live). Keep this above the poll interval and close to it.\n// The residual cost of that overlap is at worst one duplicate notification for the\n// same transition -- far cheaper than silently dropping one, which is the\n// risk an exact, non-overlapping window would carry.\nconst WINDOW_MS = 70 * 1000;\nconst now = Date.now();\n\nconst items = $input.all();\nconst out = [];\n\nfor (const item of items) {\n  const job = item.json;\n  const createdAt = Date.parse(job.created_at);\n  const updatedAt = Date.parse(job.updated_at);\n\n  if (!Number.isNaN(createdAt) && now - createdAt <= WINDOW_MS) {\n    out.push({ json: {\n      title: `Research started: ${job.slug}`,\n      body: `topic: ${job.topic || job.source_url || '(untitled)'} | depth ${job.depth}`,\n    } });\n  }\n\n  if (job.status === 'ready' && !Number.isNaN(updatedAt) && now - updatedAt <= WINDOW_MS) {\n    out.push({ json: {\n      title: `Research ready: ${job.slug}`,\n      body: 'Markdown is ready; awaiting wiki publish.',\n    } });\n  }\n}\n\nreturn out;" },
      "id": "n-transitions",
      "name": "Detect status transitions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [180, -220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{ n8n_ntfy_url }}/{{ n8n_jobs_ntfy_topic }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Title", "value": "={% raw %}{{ $json.title }}{% endraw %}" },
            { "name": "Priority", "value": "3" },
            { "name": "Tags", "value": "n8n,books" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "={% raw %}{{ $json.body }}{% endraw %}",
        "options": {}
      },
      "id": "n-notify-transition",
      "name": "Notify job transition",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, -220]
    }
  ],
  "connections": {
    "Poll interval": { "main": [[{ "node": "Fetch job list", "type": "main", "index": 0 }]] },
    "Fetch job list": {
      "main": [
        [
          { "node": "Ready jobs", "type": "main", "index": 0 },
          { "node": "Detect status transitions", "type": "main", "index": 0 }
        ]
      ]
    },
    "Ready jobs": { "main": [[{ "node": "Claim job", "type": "main", "index": 0 }]] },
    "Claim job": {
      "main": [
        [{ "node": "Pull + wiki rebuild", "type": "main", "index": 0 }],
        []
      ]
    },
    "Pull + wiki rebuild": {
      "main": [
        [{ "node": "Parse result", "type": "main", "index": 0 }],
        [{ "node": "Notify research failure", "type": "main", "index": 0 }]
      ]
    },
    "Parse result": { "main": [[{ "node": "Ingest ok?", "type": "main", "index": 0 }]] },
    "Ingest ok?": {
      "main": [
        [{ "node": "Mark published", "type": "main", "index": 0 }],
        [{ "node": "Notify research failure", "type": "main", "index": 0 }]
      ]
    },
    "Mark published": {
      "main": [
        [{ "node": "Notify published", "type": "main", "index": 0 }],
        [{ "node": "Notify research failure", "type": "main", "index": 0 }]
      ]
    },
    "Notify research failure": {
      "main": [
        [{ "node": "Unclaim job", "type": "main", "index": 0 }],
        [{ "node": "Unclaim job", "type": "main", "index": 0 }]
      ]
    },
    "Detect status transitions": { "main": [[{ "node": "Notify job transition", "type": "main", "index": 0 }]] }
  }
}
