# Managed by Ansible — services/monitoring/ntfy
services:
  ntfy:
    image: {{ ntfy_image }}
    container_name: ntfy
    command: serve
    restart: unless-stopped
    ports:
      - "{{ ntfy_port }}:80"
    volumes:
      - {{ ntfy_root_dir }}/config/server.yml:/etc/ntfy/server.yml:ro
      - {{ ntfy_root_dir }}/cache:/var/cache/ntfy
      - {{ ntfy_root_dir }}/lib:/var/lib/ntfy
    environment:
      - TZ={{ timezone }}
    healthcheck:
      test: ["CMD-SHELL", "wget -q --tries=1 http://localhost:80/v1/health -O - | grep -Eo '\"healthy\"\\s*:\\s*true'"]
      interval: 60s
      timeout: 10s
      retries: 3
{% if ntfy_relay_enabled %}

  # Forwards every message on the relay topics to n8n, which sends it on to
  # Telegram. Separate container so a relay crash-loop can never take the
  # notification sink itself down.
  ntfy-relay:
    image: {{ ntfy_image }}
    container_name: ntfy-relay
    command: subscribe --from-config
    restart: unless-stopped
    depends_on: [ntfy]
    volumes:
      - {{ ntfy_root_dir }}/config/client.yml:/etc/ntfy/client.yml:ro
    environment:
      - TZ={{ timezone }}
{% endif %}
