# Managed by Ansible — services/monitoring/diun
watch:
  workers: 4
  schedule: "{{ diun_schedule }}"
  firstCheckNotif: false

providers:
  docker:
    # Diun defaults watchByDefault to false, which means it only watches
    # containers carrying the label diun.enable=true. Without this the provider
    # finds nothing and logs "No image found" every cycle -- which is exactly
    # what it did from deployment until 2026-08-30.
    watchByDefault: {{ diun_watch_by_default | lower }}
    watchStopped: {{ diun_watch_stopped | lower }}

notif:
  ntfy:
    endpoint: "{{ diun_ntfy_endpoint }}"
    topic: "{{ diun_ntfy_topic }}"
    priority: 3
    timeout: 10s
{% if diun_webhook_endpoint %}
  # Fan-out to n8n, which decides whether the image may be auto-upgraded
  # (stateless) or only reported (stateful — see ops/maintenance).
  webhook:
    endpoint: "{{ diun_webhook_endpoint }}"
    method: POST
    timeout: 10s
{% endif %}
