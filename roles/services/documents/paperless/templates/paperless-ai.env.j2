# Managed by Ansible — services/documents/paperless
#
# paperless-ai claims Docker-injected environment outranks its setup wizard.
# In practice the Node app logs "No .env file found. Starting setup process..."
# and aborts scanning regardless of the container environment — it reads its
# core config from this file only. So Ansible writes the file itself: same
# declarative outcome as env, just the source the app actually honours. The
# first-run wizard therefore never needs to be touched.

PAPERLESS_AI_INITIAL_SETUP=no
PAPERLESS_API_URL=http://webserver:8000/api
PAPERLESS_API_TOKEN={{ _paperless_ai_token }}
PAPERLESS_USERNAME={{ paperless_ai_service_user }}

# Aliases for the bundled Python RAG service, which reads a different set of
# names than the Node app writes (upstream issue #896) and otherwise reports
# "Server: Offline". These take the base URL, with no /api suffix.
PAPERLESS_URL=http://webserver:8000
PAPERLESS_NGX_URL=http://webserver:8000
PAPERLESS_HOST=http://webserver:8000
PAPERLESS_TOKEN={{ _paperless_ai_token }}
PAPERLESS_APIKEY={{ _paperless_ai_token }}

# Local llama.cpp over its OpenAI-compatible surface. llama.cpp needs no key,
# but paperless-ai rejects an empty one.
AI_PROVIDER=custom
CUSTOM_BASE_URL=http://llama:{{ paperless_llama_port }}/v1
CUSTOM_MODEL={{ paperless_llama_model_alias }}
CUSTOM_API_KEY=not-required
OPENAI_API_KEY=
OPENAI_MODEL=

SCAN_INTERVAL={{ paperless_ai_scan_interval }}

# OPT-IN ROLLOUT. Counter-intuitively, PROCESS_PREDEFINED_DOCUMENTS=yes is the
# *restrictive* setting: it limits processing to documents carrying the TAGS
# below. Setting it to "no" turns it loose on the entire archive — 182
# documents here — on the first scan. Start opt-in: nothing is touched until a
# document is deliberately tagged "{{ paperless_ai_trigger_tag }}" in Paperless.
PROCESS_PREDEFINED_DOCUMENTS={{ paperless_ai_process_predefined }}
TAGS={{ paperless_ai_trigger_tag }}

# Tag everything it touches, so its work is reversible with one filter.
ADD_AI_PROCESSED_TAG={{ paperless_ai_add_processed_tag }}
AI_PROCESSED_TAG_NAME={{ paperless_ai_processed_tag }}

USE_PROMPT_TAGS=no
PROMPT_TAGS=
USE_EXISTING_DATA=no

# Guards paperless-ai's own HTTP API (not Paperless's).
API_KEY={{ paperless_ai_api_key }}
