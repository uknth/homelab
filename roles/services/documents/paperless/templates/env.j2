# Managed by Ansible — services/documents/paperless
PAPERLESS_REDIS=redis://broker:6379
PAPERLESS_DBHOST=db
PAPERLESS_DBNAME={{ paperless_db_name }}
PAPERLESS_DBUSER={{ paperless_db_user }}
PAPERLESS_DBPASS={{ paperless_db_password }}
PAPERLESS_SECRET_KEY={{ paperless_secret_key }}
PAPERLESS_URL={{ paperless_url }}
PAPERLESS_ACCOUNT_DEFAULT_HTTP_PROTOCOL=https
PAPERLESS_TIME_ZONE={{ timezone }}
PAPERLESS_OCR_LANGUAGE={{ paperless_ocr_language }}
USERMAP_UID={{ paperless_puid }}
USERMAP_GID={{ paperless_pgid }}
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=http://tika:9998
# DB container init (ignored once pgdata exists, kept for a fresh rebuild)
POSTGRES_DB={{ paperless_db_name }}
POSTGRES_USER={{ paperless_db_user }}
POSTGRES_PASSWORD={{ paperless_db_password }}

# --- Authentik OIDC (django-allauth) ---
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIAL_AUTO_SIGNUP=true
PAPERLESS_ACCOUNT_ALLOW_SIGNUPS=false
{% set _oidc = {"openid_connect": {"APPS": [{"provider_id": "authentik", "name": "Authentik", "client_id": paperless_oidc_client_id, "secret": paperless_oidc_client_secret, "settings": {"server_url": paperless_oidc_issuer ~ ".well-known/openid-configuration"}}]}} %}
PAPERLESS_SOCIALACCOUNT_PROVIDERS={{ _oidc | to_json }}
