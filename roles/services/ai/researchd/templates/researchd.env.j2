# Managed by Ansible — services/ai/researchd
#
# Carries RESEARCHD_LLM_API_KEY (== omlx_api_key) in clear. This file MUST
# stay mode 0600 and the templating task MUST stay no_log: true —
# ops/gitops_executor runs `site.yml --check --diff` on a timer and writes
# the output to a log file, so a diffed secret would otherwise be persisted
# there. Same pattern, same reason, as
# roles/services/ai/omlx/tasks/macos.yml's launchd plist.
RESEARCHD_LLM_BASE_URL={{ researchd_llm_base_url }}
RESEARCHD_LLM_API_KEY={{ omlx_api_key }}
RESEARCHD_LLM_MODEL={{ researchd_llm_model }}
RESEARCHD_SEARXNG_URL=http://searxng:8080
RESEARCHD_DATA_DIR=/data
RESEARCHD_PORT={{ researchd_port }}
