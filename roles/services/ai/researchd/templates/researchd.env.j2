# Managed by Ansible — services/ai/researchd
#
# Carries RESEARCHD_LLM_API_KEY (== omlx_api_key) in clear. This file MUST
# stay mode 0600 and the templating task MUST stay no_log: true —
# ops/gitops_executor runs `site.yml --check --diff` on a timer and writes
# the output to a log file, so a diffed secret would otherwise be persisted
# there. Same pattern, same reason, as
# roles/services/ai/omlx/tasks/macos.yml's launchd plist.
RESEARCHD_LLM_BASE_URL={{ researchd_llm_base_url }}
RESEARCHD_LLM_API_KEY={{ omlx_api_key }}
RESEARCHD_LLM_MODEL={{ researchd_llm_model }}
RESEARCHD_SEARXNG_URL=http://searxng:8080
RESEARCHD_DATA_DIR=/data
RESEARCHD_PORT={{ researchd_port }}
RESEARCHD_GPTR_URL=http://{{ researchd_gptr_container_name }}:{{ researchd_gptr_port }}
RESEARCHD_DEFAULT_ENGINE={{ researchd_default_engine }}

# --- engine sidecars ------------------------------------------------------
# One env_file is shared by researchd and the engine sidecar, so the omlx
# key is written once rather than templated into files that could drift.
# Each container reads only the names it knows; the unused ones are inert.
#
# The LLM and the EMBEDDING endpoints are DIFFERENT base URLs and must stay
# that way: omlx serves chat completions only and has no /v1/embeddings, so
# an engine that let its embedding client inherit OPENAI_BASE_URL would fail
# at its first embed call, not at startup.
OPENAI_BASE_URL={{ researchd_llm_base_url }}
OPENAI_API_KEY={{ omlx_api_key }}
FAST_LLM=openai:{{ researchd_llm_model }}
SMART_LLM=openai:{{ researchd_llm_model }}
STRATEGIC_LLM=openai:{{ researchd_llm_model }}

GPTR_PORT={{ researchd_gptr_port }}
RETRIEVER=searx,arxiv
SEARX_URL=http://searxng:8080

EMBEDDING=openai:{{ researchd_embed_model_name }}
EMBEDDING_BASE_URL=http://{{ researchd_embed_container_name }}:{{ researchd_embed_port }}/v1
# llama.cpp's server does not require a key, but the OpenAI client library
# refuses to construct without one, so this is a placeholder rather than a
# secret — it is deliberately NOT omlx_api_key, which must never be sent to
# anything other than omlx.
EMBEDDING_API_KEY=not-needed
# The SERVED model's real context window, for honesty rather than because it
# is load bearing: gpt-researcher chunks pages to ~250 tokens before embedding
# anything. The flag that actually matters is check_embedding_ctx_length,
# which the sidecar forces to False -- see files/engines/gptr/gptr/config.py.
EMBEDDING_CTX_LENGTH={{ researchd_embed_ctx }}

