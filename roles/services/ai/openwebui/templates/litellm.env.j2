# Managed by Ansible — services/ai/openwebui, LiteLLM proxy
#
# Carries OMLX_API_KEY, ANTHROPIC_API_KEY, and LITELLM_MASTER_KEY in clear.
# This file MUST stay mode 0600 and the templating task MUST stay
# no_log: true — ops/gitops_executor runs `site.yml --check --diff` on a
# timer and writes the output to a log file, so a diffed secret would
# otherwise be persisted there. Same pattern, same reason, as
# openwebui.env.j2 and roles/services/knowledge/vaultask/templates/
# vaultask.env.j2.
#
# These are the ONLY provider keys in this compose project now — Open
# WebUI's own env file (openwebui.env.j2) holds neither omlx_api_key nor
# vault_anthropic_api_key any more; that is the point of putting LiteLLM in
# front of it. Names below are referenced from litellm-config.yaml.j2 as
# os.environ/<name> — they MUST match exactly.
TZ={{ timezone }}

OMLX_API_KEY={{ omlx_api_key }}
ANTHROPIC_API_KEY={{ vault_anthropic_api_key }}
LITELLM_MASTER_KEY={{ _openwebui_litellm_master_key }}
