# Managed by Ansible — services/ai/openwebui
#
# Carries OPENAI_API_KEY (== omlx_api_key) and WEBUI_SECRET_KEY in clear.
# This file MUST stay mode 0600 and the templating task MUST stay
# no_log: true — ops/gitops_executor runs `site.yml --check --diff` on a
# timer and writes the output to a log file, so a diffed secret would
# otherwise be persisted there. Same pattern, same reason, as
# roles/services/knowledge/vaultask/templates/vaultask.env.j2.
TZ={{ timezone }}

# --- LLM backend: omlx on ai01, and ONLY omlx --------------------------
# ENABLE_OLLAMA_API=false: this fleet does not run Ollama anywhere (see
# roles/services/ai/omlx/defaults/main.yml for why omlx was chosen over
# it) — leaving Open WebUI's built-in Ollama auto-discovery on would have
# it probe for a backend that will never exist here.
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true

# TWO connections, semicolon-separated and positionally paired with the keys
# below: the local model first, Anthropic second.
#
# Anthropic is configured here as an "OpenAI API connection" because that is
# exactly what Open WebUI's own Anthropic guide says to do — point a connection
# at https://api.anthropic.com/v1 and it detects the provider and translates.
# Doing it through env vars rather than the admin UI keeps it in git: a
# connection added by clicking is state that lives only in the container's
# database and vanishes on a rebuild.
#
# ORDER MATTERS — OPENAI_API_KEYS is matched to OPENAI_API_BASE_URLS by
# position. Getting it wrong sends the omlx key to Anthropic and vice versa.
OPENAI_API_BASE_URLS={{ openwebui_llm_base_url }};{{ openwebui_anthropic_base_url }}
OPENAI_API_KEYS={{ omlx_api_key }};{{ vault_anthropic_api_key }}

# --- Which model a new chat starts on -------------------------------------
# Qwen is the primary. Every new conversation opens on the local model, so
# reaching Anthropic is a deliberate switch rather than the default path — the
# fleet's own model costs nothing and never leaves the LAN.
#
# LIMITATION, stated plainly: this sets the DEFAULT, it does not RESTRICT.
# Open WebUI's per-connection model allowlist (OPENAI_API_CONFIGS, with
# model_ids) is broken upstream — the variable is parsed into an empty dict and
# ignored, see open-webui/open-webui#19017 — so the picker will list every
# Anthropic model this key can reach, Opus included. The allowlist has to be
# set once in Settings -> Admin -> Connections -> Model IDs (Filter), where it
# persists in the container's database.
#
# If that cap needs to be enforced in code rather than by a setting someone
# could undo, the way to do it is a small LiteLLM proxy in front of Anthropic
# exposing exactly one model. Not built; noted deliberately.
DEFAULT_MODELS={{ openwebui_default_model }}

# --- Authentication: NONE, by explicit request ---------------------------
# WEBUI_AUTH=false removes login entirely — no accounts, no sign-in, everyone
# who can reach the page is the same anonymous user. The vhost is also
# sso: false, so there is no Authentik gate in front either.
#
# Two consequences worth being awake to:
#   1. This endpoint SPENDS MONEY. Anthropic is metered per token, and anyone
#      on the LAN can now use it without identifying themselves. A spend cap on
#      the Anthropic Console is the only backstop.
#   2. Open WebUI does not support flipping this back to true on a data
#      directory that was created without auth — turning login back on later
#      means starting its database over.
#
# ENABLE_SIGNUP is irrelevant with auth off, and is left here only so the
# setting is not silently lost if auth is ever re-enabled.
WEBUI_AUTH=false
ENABLE_SIGNUP={{ openwebui_enable_signup | lower }}

# --- Session signing -------------------------------------------------------
# See the tasks/main.yml comment on _openwebui_secret_key for why this is
# generated and persisted by this role rather than left to the container's
# own first-boot default.
WEBUI_SECRET_KEY={{ _openwebui_secret_key }}
