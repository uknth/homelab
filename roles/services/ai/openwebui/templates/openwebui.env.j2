# Managed by Ansible — services/ai/openwebui
#
# Carries OPENAI_API_KEY (== the LiteLLM master key) and WEBUI_SECRET_KEY in
# clear. This file MUST stay mode 0600 and the templating task MUST stay
# no_log: true — ops/gitops_executor runs `site.yml --check --diff` on a
# timer and writes the output to a log file, so a diffed secret would
# otherwise be persisted there. Same pattern, same reason, as
# roles/services/knowledge/vaultask/templates/vaultask.env.j2.
TZ={{ timezone }}

# --- LLM backend: LiteLLM, and ONLY LiteLLM --------------------------------
# ENABLE_OLLAMA_API=false: this fleet does not run Ollama anywhere (see
# roles/services/ai/omlx/defaults/main.yml for why omlx was chosen over
# it) — leaving Open WebUI's built-in Ollama auto-discovery on would have
# it probe for a backend that will never exist here.
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true

# ONE connection now, not two: LiteLLM (docker-compose.yml.j2), reached only
# as http://litellm:4000 on this project's own network. Open WebUI holds no
# provider keys any more — omlx_api_key and vault_anthropic_api_key live
# only in litellm.env (see defaults/main.yml's "LiteLLM" section for the
# full why: this endpoint has no login, so model restriction has to be
# enforced by a proxy that only defines the reachable models, not configured
# by a per-connection allowlist that is broken upstream anyway,
# open-webui/open-webui#19017).
#
# The old two-connection setup (OPENAI_API_BASE_URLS / OPENAI_API_KEYS,
# semicolon-paired, local model first and Anthropic second) is gone
# entirely, not just narrowed to one entry — this is a genuinely different
# shape, singular vars instead of plural.
OPENAI_API_BASE_URL=http://{{ openwebui_litellm_container_name }}:{{ openwebui_litellm_port }}/v1
OPENAI_API_KEY={{ _openwebui_litellm_master_key }}

# --- Which model a new chat starts on -------------------------------------
# The local alias, as LITELLM names it (openwebui_litellm_local_alias) — NOT
# the raw omlx model id, which LiteLLM is now the only thing that knows.
# Every new conversation opens on the local model, so reaching Anthropic is
# a deliberate switch rather than the default path — the fleet's own model
# costs nothing and never leaves the LAN.
#
# The restriction to Sonnet/Haiku (Opus excluded) that used to be a note
# here about an unenforced Settings -> Admin -> Connections allowlist is now
# ENFORCED by LiteLLM's own model_list — see litellm-config.yaml.j2's header
# comment and defaults/main.yml's "LiteLLM" section. Opus cannot appear in
# the picker at all, because litellm never defines it as a model.
DEFAULT_MODELS={{ openwebui_litellm_local_alias }}

# Open WebUI defaults ENABLE_EVALUATION_ARENA_MODELS to True (its config.py),
# which adds an "Arena Model" entry to the picker alongside the real models —
# it showed up on the first deploy of this role. See defaults/main.yml for why
# it is off: picker clutter, and an arena entry routes to a random model, which
# on a login-less endpoint means unintended Anthropic spend.
ENABLE_EVALUATION_ARENA_MODELS={{ openwebui_enable_arena_models | lower }}

# --- Authentication: NONE, by explicit request ---------------------------
# WEBUI_AUTH=false removes login entirely — no accounts, no sign-in, everyone
# who can reach the page is the same anonymous user. The vhost is also
# sso: false, so there is no Authentik gate in front either.
#
# Two consequences worth being awake to:
#   1. This endpoint SPENDS MONEY. Anthropic is metered per token, and anyone
#      on the LAN can now use it without identifying themselves. A spend cap on
#      the Anthropic Console is the only backstop.
#   2. Open WebUI does not support flipping this back to true on a data
#      directory that was created without auth — turning login back on later
#      means starting its database over.
#
# ENABLE_SIGNUP is near-irrelevant with auth off, and is left here only so the
# setting is not silently lost if auth is ever re-enabled. One caveat found by
# testing on 2026-09-08: Open WebUI allows the FIRST user to be created as an
# admin regardless of this flag. That is what makes WEBUI_AUTH=false work at
# all — the instance ships with zero users, and the first visit creates the
# implicit admin. So a fresh deploy legitimately shows `onboarding: true` and
# an empty /api/models until someone opens the page once.
WEBUI_AUTH=false
ENABLE_SIGNUP={{ openwebui_enable_signup | lower }}

# --- Session signing -------------------------------------------------------
# See the tasks/main.yml comment on _openwebui_secret_key for why this is
# generated and persisted by this role rather than left to the container's
# own first-boot default.
WEBUI_SECRET_KEY={{ _openwebui_secret_key }}
