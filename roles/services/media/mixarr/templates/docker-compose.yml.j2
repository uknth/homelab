# Managed by Ansible — services/media/mixarr
services:
  mixarr:
    image: {{ mixarr_image }}
    container_name: mixarr
    restart: unless-stopped
    ports:
      - "{{ mixarr_port }}:443"   # container serves TLS on 443 (Caddy); nginx proxies https
    environment:
      - SESSION_SECRET={{ mixarr_session_secret }}
      - BASE_URL=https://mixarr.{{ base_domain }}
      - MIXARR_SKIP_NETWORK_PREFLIGHT=1   # homelab is IPv4-only (AAAA filtered)
    volumes:
      - {{ mixarr_root_dir }}/data:/data
