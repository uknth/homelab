# Managed by Ansible — services/media/soularr
networks:
  arr:
    external: true
services:
  soularr:
    image: {{ soularr_image }}
    container_name: soularr
    user: "{{ soularr_puid }}:{{ soularr_pgid }}"
    restart: unless-stopped
    networks: [arr]
    ports:
      - "{{ soularr_webui_port }}:8265"
    environment:
      - TZ={{ timezone }}
      - SCRIPT_INTERVAL={{ soularr_interval }}
      - WEBUI_ENABLED=true
    volumes:
      - {{ soularr_root_dir }}/config:/data
      - {{ media_data_dir }}/downloads/soulseek:/data/downloads/soulseek
