# Managed by Ansible — services/media/arr
networks:
  arr:
    name: arr

services:
  # ---- VPN gateway: ONLY qbittorrent uses this netns ----
  gluetun:
    image: qmcgaw/gluetun:latest
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    networks:
      - arr
    ports:
      - "{{ arr_qbittorrent_port }}:{{ arr_qbittorrent_port }}"   # qbit web UI, via gluetun
    volumes:
      - {{ arr_root_dir }}/gluetun:/gluetun
    env_file: [.env]
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "ping", "-c", "1", "www.google.com"]
      interval: 30s
      timeout: 10s
      retries: 5

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:{{ arr_ls_image_tag }}
    container_name: qbittorrent
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ timezone }}
      - WEBUI_PORT={{ arr_qbittorrent_port }}
    volumes:
      - {{ arr_root_dir }}/qbittorrent:/config
      - {{ arr_data_dir }}:/data
      - {{ scratch_incomplete_dir }}:/scratch
    restart: unless-stopped

  # ---- *arr apps: normal bridge network, NOT behind VPN ----
  # ---- Usenet downloader (PRIMARY): bridge network, NOT behind VPN ----
  nzbget:
    image: lscr.io/linuxserver/nzbget:{{ arr_ls_image_tag }}
    container_name: nzbget
    networks: [arr]
    ports: ["{{ arr_nzbget_port }}:6789"]
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ timezone }}
    volumes:
      - {{ arr_root_dir }}/nzbget:/config
      - {{ arr_data_dir }}:/data
      - {{ scratch_incomplete_dir }}:/scratch
    restart: unless-stopped

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:{{ arr_ls_image_tag }}
    container_name: prowlarr
    networks: [arr]
    ports: ["{{ arr_prowlarr_port }}:9696"]
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ timezone }}
    volumes:
      - {{ arr_root_dir }}/prowlarr:/config
    restart: unless-stopped

  sonarr:
    image: lscr.io/linuxserver/sonarr:{{ arr_ls_image_tag }}
    container_name: sonarr
    networks: [arr]
    ports: ["{{ arr_sonarr_port }}:8989"]
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ timezone }}
    volumes:
      - {{ arr_root_dir }}/sonarr:/config
      - {{ arr_data_dir }}:/data
    restart: unless-stopped

  radarr:
    image: lscr.io/linuxserver/radarr:{{ arr_ls_image_tag }}
    container_name: radarr
    networks: [arr]
    ports: ["{{ arr_radarr_port }}:7878"]
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ timezone }}
    volumes:
      - {{ arr_root_dir }}/radarr:/config
      - {{ arr_data_dir }}:/data
    restart: unless-stopped

  lidarr:
    image: lscr.io/linuxserver/lidarr:{{ arr_ls_image_tag }}
    container_name: lidarr
    networks: [arr]
    ports: ["{{ arr_lidarr_port }}:8686"]
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ timezone }}
    volumes:
      - {{ arr_root_dir }}/lidarr:/config
      - {{ arr_data_dir }}:/data
    restart: unless-stopped

  bazarr:
    image: lscr.io/linuxserver/bazarr:{{ arr_ls_image_tag }}
    container_name: bazarr
    networks: [arr]
    ports: ["{{ arr_bazarr_port }}:6767"]
    environment:
      - PUID={{ arr_puid }}
      - PGID={{ arr_pgid }}
      - TZ={{ timezone }}
    volumes:
      - {{ arr_root_dir }}/bazarr:/config
      - {{ arr_data_dir }}:/data
    restart: unless-stopped
{% if arr_unpackerr_enabled and _arr_api is defined and _arr_api.sonarr is defined %}

  # ---- unpackerr: extracts inner RAR sets nzbget left behind ----
  # See defaults/main.yml for the failure mode this fixes.
  unpackerr:
    image: {{ arr_unpackerr_image }}
    container_name: unpackerr
    networks: [arr]
    # NOT a linuxserver.io image: it takes user:group directly and ignores
    # PUID/PGID env vars, unlike every other service in this file.
    user: "{{ arr_puid }}:{{ arr_pgid }}"
    volumes:
      - {{ arr_root_dir }}/unpackerr:/config
      # MUST be mounted at the same path the *arrs use: unpackerr resolves the
      # outputPath the Starr API reports (/data/downloads/...) verbatim.
      - {{ arr_data_dir }}:/data
    environment:
      - TZ={{ timezone }}
      - UN_INTERVAL={{ arr_unpackerr_interval }}
      - UN_START_DELAY={{ arr_unpackerr_start_delay }}
      # Log to the config volume, not /data — /data is the media pool.
      - UN_LOG_FILE=/config/unpackerr.log
      - UN_LOG_FILES=5
{% for app, iport in [('sonarr', 8989), ('radarr', 7878), ('lidarr', 8686)] %}
{% if _arr_api[app] is defined %}
      # Container-to-container: fixed INTERNAL port, deliberately not arr_{{ app }}_port
      # (that is the host-side port and would break if it were ever remapped).
      - UN_{{ app | upper }}_0_URL=http://{{ app }}:{{ iport }}
      - UN_{{ app | upper }}_0_API_KEY=${UN_{{ app | upper }}_0_API_KEY}
      - UN_{{ app | upper }}_0_PATHS_0={{ arr_unpackerr_paths }}
      - UN_{{ app | upper }}_0_PROTOCOLS={{ arr_unpackerr_protocols }}
      - UN_{{ app | upper }}_0_DELETE_DELAY={{ arr_unpackerr_delete_delay }}
      - UN_{{ app | upper }}_0_DELETE_ORIG=false
{% endif %}
{% endfor %}
    env_file: [.env]
    restart: unless-stopped
{% endif %}
