# Managed by Ansible — services/media/arr (gluetun VPN)
VPN_SERVICE_PROVIDER={{ arr_vpn_provider }}
VPN_TYPE={{ arr_vpn_type }}
OPENVPN_USER={{ arr_vpn_user }}
OPENVPN_PASSWORD={{ arr_vpn_password }}
SERVER_REGIONS={{ arr_vpn_regions }}
VPN_PORT_FORWARDING=on
VPN_PORT_FORWARDING_STATUS_FILE=/gluetun/forwarded_port
PORT_FORWARD_ONLY=on
FIREWALL_OUTBOUND_SUBNETS={{ arr_lan_subnet }}
TZ={{ timezone }}
{% if _arr_api is defined %}

# ---- unpackerr: *arr API keys (read from each app's config.xml) ----
{% for app in ['sonarr', 'radarr', 'lidarr'] %}
{% if _arr_api[app] is defined %}
UN_{{ app | upper }}_0_API_KEY={{ _arr_api[app].key }}
{% endif %}
{% endfor %}
{% endif %}
