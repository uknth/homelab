# Managed by Ansible — services/media/jellyfin
networks:
  jellyfin:
    name: jellyfin

services:
  jellyfin:
    image: lscr.io/linuxserver/jellyfin:latest
    container_name: jellyfin
    networks: [jellyfin]
    ports:
      - "{{ jellyfin_port }}:8096"
    environment:
      - PUID={{ jellyfin_puid }}
      - PGID={{ jellyfin_pgid }}
      - TZ={{ timezone }}
      - NVIDIA_VISIBLE_DEVICES=all
      - NVIDIA_DRIVER_CAPABILITIES=all
      - JELLYFIN_PublishedServerUrl={{ jellyfin_published_url }}
    volumes:
      - {{ jellyfin_root_dir }}/config:/config
      - {{ jellyfin_data_dir }}:/data
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    restart: unless-stopped

  # Seerr — successor to Jellyseerr (fallenbagel/jellyseerr is frozen at 2.7.3,
  # which only sends the legacy X-Emby-* auth headers that Jellyfin 12 rejects).
  # Reads the existing Jellyseerr config/db in place. Service + container keep
  # the old name so nothing downstream (proxy, homepage) has to change.
  jellyseerr:
    image: ghcr.io/seerr-team/seerr:v3
    init: true
    container_name: jellyseerr
    networks: [jellyfin]
    ports:
      - "{{ jellyseerr_port }}:5055"
    environment:
      - TZ={{ timezone }}
      - LOG_LEVEL=info
    volumes:
      - {{ jellyfin_root_dir }}/jellyseerr:/app/config
    restart: unless-stopped
