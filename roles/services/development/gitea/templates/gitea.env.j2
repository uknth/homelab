# Managed by Ansible — services/development/gitea
USER_UID={{ gitea_uid }}
USER_GID={{ gitea_gid }}
TZ={{ timezone }}

GITEA__database__DB_TYPE={{ gitea_db_type }}

# Repositories + LFS objects live on the NFS mount ({{ gitea_repo_root_path }},
# see docker-compose.yml.j2), NOT under /data. The SQLite db above stays on
# local disk instead — see the storage-split comment in defaults/main.yml for
# why the two are split this way and must stay split.
GITEA__repository__ROOT={{ gitea_repo_root_path }}
GITEA__lfs__PATH={{ gitea_lfs_path }}

# WITHOUT THIS Gitea does not configure itself at all. It writes app.ini and
# initialises the database only once installation is marked complete; left
# unset it ignores every GITEA__* variable above, logs "Prepare to run install
# page", and serves the interactive web installer instead. Everything
# downstream then fails confusingly rather than obviously — `gitea admin user
# create` reports no such table, because no schema has been created yet.
#
# Setting it declares "this instance is configured by Ansible, not by a human
# clicking through a wizard", which is the whole point of the role.
GITEA__security__INSTALL_LOCK=true

GITEA__server__DOMAIN={{ gitea_domain }}
GITEA__server__ROOT_URL={{ gitea_root_url }}
GITEA__server__SSH_DOMAIN={{ gitea_ssh_domain }}
# The port clone/clone-over-SSH URLs advertise. This is 22, NOT
# gitea_ssh_host_port — clones now reach Gitea via gitea_ssh_ip's own port 22
# (the ssh-redirect sidecar, see docker-compose.yml.j2), not via the host
# publish. This is also a DIFFERENT thing from SSH_LISTEN_PORT right below:
# that is what the container itself binds internally and stays 22 always;
# this is only what generated `git clone` URLs say to connect to. Conflating
# the two is exactly how a clone URL ends up lying about how to reach it.
GITEA__server__SSH_PORT={{ gitea_ssh_advertised_port }}
GITEA__server__SSH_LISTEN_PORT=22

# Single-user instance, own login (see defaults/main.yml) — registration is
# off and every page requires sign-in.
GITEA__service__DISABLE_REGISTRATION={{ gitea_disable_registration | lower }}
GITEA__service__REQUIRE_SIGNIN_VIEW={{ gitea_require_signin_view | lower }}
