# Managed by Ansible — services/dashboard/homepage
title: Homelab
theme: {{ homepage_theme }}
color: {{ homepage_color }}
headerStyle: clean
target: _blank
hideVersion: true
disableUpdateCheck: true
useEqualHeights: false
# Two tabs. Links (bookmarks) on top; widget groups (services) below, arranged into
# two panes by custom.css (#services columns:2). Widget groups use columns:1 so their
# widgets stack vertically within each pane. Group render order follows this block.
layout:
  # ---- Home (family) — links (wider boxes) ----
  Watch: { tab: Home, style: row, columns: 3 }
  Listen & Read: { tab: Home, style: row, columns: 3 }
  Files: { tab: Home, style: row, columns: 3 }
  # ---- Home — widgets (left pane: Media | right pane: Weather, Documents) ----
  Media: { tab: Home, style: column, columns: 1 }
  Weather: { tab: Home, style: column, columns: 1 }
  Documents: { tab: Home, style: column, columns: 1 }
  # Moved from the System tab. The old comment here warned that the wiki
  # republishes whole vaults including Secrets/ and Finances/ — that is still
  # true (vaultsync excludes nothing, per the 2026-09-01 decision), but the tab
  # was never what protected it: wiki.* and ask.* are both sso: true, so
  # Authentik is the gate and a dashboard tab is only organisation.
  Knowledge: { tab: Home, style: row, columns: 4 }
  Assistant: { tab: Home, style: row, columns: 4 }
  # ---- System (admin) — links ----
  Downloaders: { tab: System, style: row, columns: 4 }
  Storage & Sync: { tab: System, style: row, columns: 3 }
  Admin: { tab: System, style: row, columns: 4 }
  # Gitea and anything else developer-facing. System rather than Home: nobody
  # in the family has a reason to open a git forge, and it keeps Home to things
  # people actually use.
  Development: { tab: System, style: row, columns: 4 }
  # ---- System — status band (full width, above the two panes) ----
  Status: { tab: System, style: row, columns: 2 }
  # ---- System — widgets (two panes) ----
  Download Activity: { tab: System, style: column, columns: 1 }
  System Health: { tab: System, style: column, columns: 1 }
{% if hp_portainer_token and hp_nodes %}
  # ---- Nodes — one group per Docker node, discovered from the Portainer API ----
{% for name, id in (hp_nodes | dictsort) %}
  {{ homepage_node_name_map.get(name, name) }}: { tab: Nodes, style: column, columns: 1 }
{% endfor %}
{% endif %}
