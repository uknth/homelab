# Managed by Ansible — services/dashboard/homepage
title: Homelab
theme: {{ homepage_theme }}
color: {{ homepage_color }}
headerStyle: clean
target: _blank
hideVersion: true
disableUpdateCheck: true
useEqualHeights: true
# Three tabs only. Each group below is a titled section under its tab.
layout:
  Media:
    tab: Media
    style: row
    columns: 3
  Music:
    tab: Media
    style: row
    columns: 4
  Downloads:
    tab: Downloads
    style: row
    columns: 4
  Documents & Files:
    tab: System
    style: row
    columns: 3
  Storage:
    tab: System
    style: row
    columns: 2
  Infrastructure:
    tab: System
    style: row
    columns: 4
