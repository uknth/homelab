# Managed by Ansible — services/dashboard/homepage
title: Homelab
theme: {{ homepage_theme }}
color: {{ homepage_color }}
headerStyle: clean
target: _blank
hideVersion: true
disableUpdateCheck: true
useEqualHeights: true
# Two tabs. Within each tab: link groups (bookmarks) first, widget groups (services) below.
layout:
  # ---- Home (family) — links ----
  Watch: { tab: Home, style: row, columns: 4 }
  Listen & Read: { tab: Home, style: row, columns: 4 }
  Files: { tab: Home, style: row, columns: 4 }
  # ---- Home — widgets ----
  Weather: { tab: Home, style: row, columns: 1 }
  Media: { tab: Home, style: row, columns: 2 }
  # ---- System (admin) — links ----
  Downloaders: { tab: System, style: row, columns: 5 }
  Storage & Sync: { tab: System, style: row, columns: 3 }
  Admin: { tab: System, style: row, columns: 4 }
  # ---- System — widgets ----
  Download Activity: { tab: System, style: row, columns: 4 }
  System Health: { tab: System, style: row, columns: 4 }
