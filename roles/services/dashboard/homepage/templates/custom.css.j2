/* Managed by Ansible — services/dashboard/homepage : clean light aesthetic */
body {
  background: linear-gradient(160deg, #f6f8fc 0%, #edf1f8 50%, #e8eef7 100%) fixed !important;
}
#page_container,
main,
#page_wrapper { background: transparent !important; }

/* soft, rounded, low-contrast cards */
.service-card,
#information-widgets > div {
  background: #ffffff !important;
  border: 1px solid #e6ebf2 !important;
  border-radius: 12px !important;
  box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05) !important;
}
.service-card:hover { box-shadow: 0 3px 8px rgba(16, 24, 40, 0.08) !important; }

/* tab bar + group titles: quieter, more breathing room */
#myTab { gap: .25rem; }
.services-group { margin-bottom: 1.25rem; }
h2 { font-weight: 600; letter-spacing: .01em; }
