# Managed by Ansible — services/dashboard/homepage
# WIDGETS block (live data). App launcher links live in bookmarks.yaml.
# Groups placed into tabs (2-column) by settings.yaml.

# ===== Home tab =====
- Media:
    - Jellyfin:
        href: https://video.{{ base_domain }}
        icon: jellyfin.png
{% if hp_jellyfin_key %}
        widget:
          type: jellyfin
          url: http://{{ homepage_media_host }}:8096
          key: {{ hp_jellyfin_key }}
          enableBlocks: true
          enableNowPlaying: true
{% endif %}
    - Jellyseerr:
        href: https://seer.{{ base_domain }}
        icon: jellyseerr.png
        widget:
          type: jellyseerr
          url: http://{{ homepage_media_host }}:5055
          key: {{ hp_jseerr_key }}
    - Navidrome:
        href: https://music.{{ base_domain }}
        icon: navidrome.png
        widget:
          type: navidrome
          url: http://{{ homepage_media_host }}:4533
          user: {{ homepage_navidrome_user }}
          salt: {{ homepage_navidrome_salt }}
          token: {{ (vault_navidrome_password ~ homepage_navidrome_salt) | hash('md5') }}

- Documents:
{% if hp_paperless_key %}
    - Paperless:
        href: https://docs.{{ base_domain }}
        icon: paperless-ngx.png
        widget:
          type: paperlessngx
          url: http://{{ homepage_media_host }}:8000
          key: {{ hp_paperless_key }}
{% endif %}

- Weather:
    - Bengaluru:
        icon: mdi-weather-partly-cloudy
        widget:
          type: customapi
          url: https://api.open-meteo.com/v1/forecast?latitude={{ homepage_weather_lat }}&longitude={{ homepage_weather_long }}&current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m
          refreshInterval: 600000
          display: block
          mappings:
            - { field: current.temperature_2m, label: Temp, format: float, suffix: "°C" }
            - { field: current.apparent_temperature, label: Feels, format: float, suffix: "°C" }
            - { field: current.relative_humidity_2m, label: Humidity, format: number, suffix: "%" }
            - { field: current.wind_speed_10m, label: Wind, format: number, suffix: " km/h" }
            - field: current.weather_code
              label: Sky
              format: number
              remap:
                - { value: 0, to: Clear }
                - { value: 1, to: Mainly clear }
                - { value: 2, to: Partly cloudy }
                - { value: 3, to: Overcast }
                - { value: 45, to: Fog }
                - { value: 48, to: Fog }
                - { value: 51, to: Drizzle }
                - { value: 53, to: Drizzle }
                - { value: 55, to: Drizzle }
                - { value: 61, to: Rain }
                - { value: 63, to: Rain }
                - { value: 65, to: Heavy rain }
                - { value: 80, to: Showers }
                - { value: 81, to: Showers }
                - { value: 82, to: Heavy showers }
                - { value: 95, to: Thunderstorm }
                - { any: true, to: "—" }

# ===== System tab =====
# Status band -- full width above the two-pane widget masonry (see custom.css).
- Status:
{% if wanwatch_links | default([]) | length > 0 %}
    # Per-ISP reachability. The Uptime Kuma tile counts how many monitors are
    # down; this names which uplink it is. Source: the n8n wan-watch workflow,
    # which replays the last gw01 probe rather than probing on every refresh.
    - Internet:
        href: https://synthetics.{{ base_domain }}
        icon: mdi-wan
        description: per-ISP reachability (dual WAN)
        widget:
          type: customapi
          url: http://{{ hostvars['util01'].ansible_host }}:{{ n8n_port | default(5678) }}/webhook/wan-status
          refreshInterval: {{ homepage_wan_refresh }}
          display: block
          mappings:
{% for l in wanwatch_links %}
            - field: links.{{ loop.index0 }}.status
              label: {{ l.name }}
              remap:
                - { value: up, to: up }
                - { value: down, to: DOWN }
            - { field: links.{{ loop.index0 }}.rtt_ms, label: "{{ l.name }} rtt", format: float, suffix: " ms" }
{% endfor %}
{% endif %}
    # ntfy volume, aggregated by n8n (ntfy answers NDJSON, which customapi
    # cannot parse). Window is capped by ntfy's 12h cache-duration.
    - Alerts:
        href: https://ntfy.{{ base_domain }}/{{ homepage_alert_topics | first }}
        icon: mdi-bell-alert
        description: ntfy volume, last {{ n8n_alerts_window | default('12h') }}
        widget:
          type: customapi
          url: http://{{ hostvars['util01'].ansible_host }}:{{ n8n_port | default(5678) }}/webhook/alerts-summary
          refreshInterval: {{ homepage_alerts_refresh }}
          display: block
          mappings:
            - { field: total, label: Total, format: number }
            - { field: critical, label: High/Max, format: number }
            - { field: by_topic.homelab-alerts, label: Monitors, format: number }
            - { field: by_topic.homelab-updates, label: Updates, format: number }
            - { field: latest_title, label: Latest }
            - { field: latest_ago_min, label: Age, format: number, suffix: " min" }

- Download Activity:
    - Prowlarr:
        href: https://prowlarr.{{ base_domain }}
        icon: prowlarr.png
        widget:
          type: prowlarr
          url: http://{{ homepage_media_host }}:9696
          key: {{ hp_keys.prowlarr }}
    - Sonarr:
        href: https://sonarr.{{ base_domain }}
        icon: sonarr.png
        widget:
          type: sonarr
          url: http://{{ homepage_media_host }}:8989
          key: {{ hp_keys.sonarr }}
    - Radarr:
        href: https://radarr.{{ base_domain }}
        icon: radarr.png
        widget:
          type: radarr
          url: http://{{ homepage_media_host }}:7878
          key: {{ hp_keys.radarr }}
    - Lidarr:
        href: https://lidarr.{{ base_domain }}
        icon: lidarr.png
        widget:
          type: lidarr
          url: http://{{ homepage_media_host }}:8686
          key: {{ hp_keys.lidarr }}
{% if hp_bazarr_key %}
    - Bazarr:
        href: https://bazarr.{{ base_domain }}
        icon: bazarr.png
        widget:
          type: bazarr
          url: http://{{ homepage_media_host }}:6767
          key: {{ hp_bazarr_key }}
{% endif %}
    - NZBGet:
        href: https://nzbget.{{ base_domain }}
        icon: nzbget.png
        widget:
          type: nzbget
          url: http://{{ homepage_media_host }}:6789
          username: {{ hp_nzb_user }}
          password: {{ hp_nzb_pass }}
    - qBittorrent:
        href: https://torrent.{{ base_domain }}
        icon: qbittorrent.png
        widget:
          type: qbittorrent
          url: http://{{ homepage_media_host }}:8080
          username: {{ arr_qbit_username | default('admin') }}
          password: {{ vault_qbittorrent_password }}

- System Health:
    - TrueNAS:
        href: https://{{ hostvars['nas01'].ansible_host }}
        icon: truenas.png
        widget:
          type: truenas
          url: {{ homepage_truenas_url }}
          key: {{ vault_truenas_api_key }}
          enablePools: true
    - Beszel:
        href: https://metrics.{{ base_domain }}
        icon: beszel.png
        widget:
          type: beszel
          url: http://{{ hostvars['util01'].ansible_host }}:8090
          username: {{ vault_certbot_email }}
          password: {{ vault_beszel_superuser_password }}
          version: 2
    - Uptime Kuma:
        href: https://synthetics.{{ base_domain }}
        icon: uptime-kuma.png
        widget:
          type: uptimekuma
          url: http://{{ hostvars['util01'].ansible_host }}:3001
          slug: homelab
    - Authentik:
        href: https://auth.{{ base_domain }}
        icon: authentik.png
        widget:
          type: authentik
          url: {{ homepage_authentik_url }}
          key: {{ vault_authentik_api_token }}
{% if hp_portainer_token %}
    - Portainer:
        href: https://docker.{{ base_domain }}
        icon: portainer.png
        widget:
          type: portainer
          url: http://{{ hostvars['util01'].ansible_host }}:9001
          env: {{ hp_portainer_env }}
          key: {{ hp_portainer_token }}
{% endif %}

# ===== Nodes tab =====
# Container inventory per Docker node. Both the node list and the container list
# come from live APIs: nodes from Portainer's /api/endpoints, containers from the
# Docker API proxied through Portainer. Nothing below is enumerated by hand, so a
# container that is running but undeclared in Ansible still shows up here — which
# is the point.
{% if hp_portainer_token and hp_nodes %}
{% for name, id in (hp_nodes | dictsort) %}
{% set label = homepage_node_name_map.get(name, name) %}
- {{ label }}:
    - Containers:
        icon: docker.png
        href: https://docker.{{ base_domain }}/#!/{{ id }}/docker/containers
        description: running containers on {{ label }}
        widget:
          type: customapi
          url: http://{{ hostvars['util01'].ansible_host }}:9001/api/endpoints/{{ id }}/docker/containers/json
          method: GET
          headers:
            X-API-Key: {{ hp_portainer_token }}
          display: dynamic-list
          refreshInterval: {{ homepage_nodes_refresh }}
          mappings:
            name: Names.0
            label: Status
            limit: {{ homepage_nodes_limit }}
{% endfor %}
{% endif %}
