# Managed by Ansible — services/dashboard/homepage
# Global top bar (all tabs). Weather moved to a tab-1 service tile; search shrunk via custom.css.
- greeting:
    text_size: 3xl
    text: "{{ homepage_greeting }}"
- datetime:
    text_size: l
    format: { dateStyle: long, timeStyle: short, hour12: false }
# The Phase-8 placeholder, now wired to the real thing: the header search on
# every tab queries the wiki (work + knowledge base + personal), not the web.
- search:
    provider: custom
    url: https://ask.{{ base_domain }}/?q=
    target: _blank
