# Managed by Ansible — services/dashboard/homarr
services:
  homarr:
    image: {{ homarr_image }}
    container_name: homarr
    restart: unless-stopped
    ports:
      - "{{ homarr_port }}:7575"
    environment:
      - TZ={{ timezone }}
      - SECRET_ENCRYPTION_KEY={{ homarr_secret_encryption_key }}
      - AUTH_PROVIDERS={{ homarr_auth_providers }}
      - AUTH_OIDC_CLIENT_ID={{ homarr_oidc_client_id }}
      - AUTH_OIDC_CLIENT_SECRET={{ homarr_oidc_client_secret }}
      - AUTH_OIDC_ISSUER={{ homarr_oidc_issuer }}
      - AUTH_OIDC_CLIENT_NAME={{ homarr_oidc_name }}
      - AUTH_OIDC_AUTO_LOGIN={{ homarr_oidc_auto_login }}
    volumes:
      - {{ homarr_root_dir }}/appdata:/appdata
      - /var/run/docker.sock:/var/run/docker.sock:ro
