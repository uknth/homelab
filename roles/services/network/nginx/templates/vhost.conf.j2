# Managed by Ansible (roles/services/network/nginx) — do not edit by hand.
# vhost: {{ item.name }}.{{ base_domain }}{% if item.sso | default(false) %} (SSO){% endif %}

server {
    listen 80;
    server_name {{ item.name }}.{{ base_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ item.name }}.{{ base_domain }};

    ssl_certificate     {{ nginx_cert_dir }}/fullchain.pem;
    ssl_certificate_key {{ nginx_cert_dir }}/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

{% if item.sso | default(false) %}
    include /etc/nginx/snippets/authentik-forward-auth.conf;
{% endif %}

    location / {
{% if item.sso | default(false) %}
        include /etc/nginx/snippets/authentik-auth-request.conf;
{% endif %}
        proxy_pass {{ item.upstream }};
{% if item.upstream.startswith('https') %}
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
{% endif %}
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
