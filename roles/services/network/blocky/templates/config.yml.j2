# Managed by Ansible (roles/services/network/blocky) — do not edit by hand.
ports:
  dns: {{ blocky_dns_port }}
  http: {{ blocky_http_port }}

upstreams:
  init:
    strategy: fast
  groups:
    default:
{% for u in blocky_upstreams %}
      - {{ u }}
{% endfor %}
  # strict = try in listed order (Pi-hole, Cloudflare DoH, Quad9 DoH)
  strategy: strict
  timeout: 2s

# Local name resolution. customDNS answers a mapped domain AND its subdomains,
# so the base-domain entry is the catch-all for every *.puhome.net service
# name (all of which are reverse-proxied by nginx on gw01). More-specific
# host records override it.
customDNS:
  customTTL: 1h
  filterUnmappedTypes: true
  mapping:
    # Catch-all: every *.puhome.net service name -> nginx reverse proxy
    {{ base_domain }}: {{ blocky_reverse_proxy_ip }}
    # Per-host records (override the catch-all for real host IPs)
{% for h in (groups['linux'] | default([])) + (groups['macos'] | default([])) %}
    {{ h }}.host.{{ base_domain }}: {{ hostvars[h].ansible_host }}
{% endfor %}
{% for name, ip in blocky_pinned_hosts.items() %}
    {{ name }}: {{ ip }}
{% endfor %}
{% for name, ip in blocky_extra_mappings.items() %}
    {{ name }}: {{ ip }}
{% endfor %}

# IPv4-only network: drop AAAA queries so clients never try (unroutable)
# IPv6 addresses — prevents container HTTP clients hanging on IPv6.
filtering:
  queryTypes:
    - AAAA

# Small blocklist subset (Pi-hole carries the large lists). Lists load in the
# background (strategy fast), so a bad/unreachable list never blocks startup.
blocking:
  blockType: zeroIp
  denylists:
{% for group, urls in blocky_denylists.items() %}
    {{ group }}:
{% for u in urls %}
      - {{ u }}
{% endfor %}
{% endfor %}
{% if dns_allowlist | default([]) | length > 0 %}
  # Shared allowlist (dns_allowlist): never blocked, whichever group matches.
  allowlists:
{% for group in blocky_denylists.keys() %}
    {{ group }}:
      - |
{% for d in dns_allowlist %}
        {{ d }}
{% endfor %}
{% endfor %}
{% endif %}
  clientGroupsBlock:
    default:
{% for g in blocky_denylist_groups_default %}
      - {{ g }}
{% endfor %}
  loading:
    strategy: fast
    refreshPeriod: 24h
    downloads:
      timeout: 60s
      attempts: 3
      cooldown: 10s

prometheus:
  enable: true
  path: /metrics

log:
  level: info
  format: text
