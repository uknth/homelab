# Managed by Ansible — ops/gitops_executor
[Unit]
Description=Homelab GitOps deploy (poll git.sr.ht main -> check/apply)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ user }}
Environment=HOME=/home/{{ user }}
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart={{ gitops_dir }}/deploy.sh
