#!/usr/bin/env bash
# Managed by Ansible — ops/gitops_executor.
#   deploy.sh                -> pull {{ gitops_branch }}, dry-run (--check --diff), then apply
#                                if gitops_auto_apply. Invoked with no args by the
#                                Gitea `apply` trigger (gitops-trigger.sh) AND by the
#                                hourly backstop timer — semantics unchanged either way.
#   deploy.sh --check <ref>   -> fetch, check out <ref> DETACHED, run --check --diff
#                                ONLY (never applies, regardless of gitops_auto_apply),
#                                then return to {{ gitops_branch }}. Invoked by the Gitea
#                                `check <ref>` trigger for a PR's head commit.
# Both paths report to ntfy exactly as before.
set -uo pipefail

# Ansible refuses to run without a UTF-8 locale (systemd/non-login shells
# default to POSIX/ISO8859-1).
export LANG=C.UTF-8 LC_ALL=C.UTF-8

REPO="{{ gitops_dir }}/repo"
VENV="{{ gitops_dir }}/venv"
BRANCH="{{ gitops_branch }}"
NTFY="{{ gitops_ntfy_url }}"
AUTO_APPLY="{{ 'true' if gitops_auto_apply else 'false' }}"

# The repo is PRIVATE (see role defaults' "Out-of-band prerequisites"): a
# read-only Gitea deploy key is expected at this path, provisioned by hand,
# never by this role. IdentitiesOnly keeps ssh from also offering any other
# key in the executor user's agent/~/.ssh; accept-new matches the same
# first-connection posture as roles/ops/maintenance's remote() helper.
export GIT_SSH_COMMAND="ssh -i {{ gitops_deploy_key }} -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"

cd "$REPO" || { echo "repo not cloned at $REPO"; exit 1; }
notify() { curl -fsS -m 15 -H "Title: $1" -d "$2" "$NTFY" >/dev/null 2>&1 || true; }

# Two entry points now share this one checkout (the Gitea `check` trigger,
# the Gitea `apply` trigger, and the backstop timer all call this script).
# flock keeps a PR dry-run's detached checkout from landing mid-pull of an
# apply run, or vice versa — same idiom as
# roles/services/knowledge/vaultindex/templates/reindex.sh.j2. Degrade to
# unlocked if flock is missing: never running is worse than a rare overlap.
if command -v flock >/dev/null 2>&1; then
  exec 9>"{{ gitops_dir }}/.deploy.lock"
  if ! flock -w 300 9; then
    echo "another deploy.sh run held the lock for 5 minutes — giving up"
    notify "Deploy FAILED" "timed out waiting for another gitops run to finish"
    exit 1
  fi
fi

MODE="apply"
REF=""
if [ "${1:-}" = "--check" ]; then
  MODE="check"
  REF="${2:-}"
  [ -n "$REF" ] || { echo "usage: deploy.sh --check <ref>"; exit 1; }
fi

if [ "$MODE" = "check" ]; then
  # PR dry-run path. Fetch every branch tip (cheap on this repo's size, and
  # robust to servers that refuse to upload-pack an arbitrary bare SHA), then
  # check out the requested ref DETACHED so the tracking branch checkout
  # below is never disturbed by a ref that may never merge.
  git fetch --quiet origin
  if ! git checkout --quiet --detach "$REF"; then
    echo "checkout of $REF failed"
    notify "Deploy dry-run FAILED @ $REF" "checkout of $REF failed"
    git checkout --quiet "$BRANCH" 2>/dev/null || true
    exit 1
  fi
  SHORT=$(git rev-parse --short HEAD)
  echo "=== dry-run (--check --diff) @ $REF ($SHORT) ==="
  RC=0
  "$VENV/bin/ansible-playbook" site.yml --check --diff > /tmp/gitops-check.log 2>&1 || RC=$?
  # Always return to the tracking branch, even on failure, so the working
  # tree never sits detached and the next run (timer or another check)
  # starts from a known branch.
  git checkout --quiet "$BRANCH"
  if [ "$RC" -ne 0 ]; then
    notify "Deploy dry-run FAILED @ $REF ($SHORT)" "$(tail -c 800 /tmp/gitops-check.log)"
    echo "dry-run failed for $REF; see /tmp/gitops-check.log"
    exit 1
  fi
  notify "Deploy dry-run OK @ $REF ($SHORT)" "site.yml --check --diff clean."
  echo "dry-run OK for $REF"
  exit 0
fi

# --- apply mode: pull the tracking branch, dry-run, then apply — the
# original semantics, unchanged by any of the above. ---
git fetch --quiet origin "$BRANCH"
LOCAL=$(git rev-parse HEAD); REMOTE=$(git rev-parse "origin/$BRANCH")
if [ "$LOCAL" = "$REMOTE" ]; then
  echo "already up to date ($LOCAL)"
  exit 0
else
  echo "updating $LOCAL -> $REMOTE"
  # `reset --hard`, not `pull --ff-only`. This clone is a read-only mirror of
  # origin/$BRANCH — it never has local commits worth protecting, so "make the
  # worktree exactly what origin says" is the honest description of what this
  # step is for, and it is what --ff-only was approximating.
  #
  # --ff-only also fails outright when upstream history is rewritten, which is
  # not hypothetical: the vault purge on 2026-09-08 force-pushed master and
  # wedged this executor with "git pull failed". Every deploy stayed broken
  # until the clone was reset by hand, and the failure message pointed at git
  # rather than at the rewrite, which is the expensive part.
  #
  # A force-update is still worth SAYING, because the normal case is a
  # fast-forward and a rewrite is a genuinely unusual event.
  if ! git merge-base --is-ancestor "$LOCAL" "$REMOTE" 2>/dev/null; then
    echo "upstream history was rewritten (${LOCAL} is not an ancestor of ${REMOTE}) — resetting"
    notify "Deploy: upstream history rewritten" \
           "origin/$BRANCH no longer contains $LOCAL; the executor clone was reset to match."
  fi
  git reset --hard --quiet "origin/$BRANCH" \
    || { notify "Deploy FAILED" "git reset to origin/$BRANCH failed"; exit 1; }
  # Rewrites routinely leave files behind that the new tree does not track
  # (the purged vault paths did exactly this). Untracked leftovers would be
  # invisible to git status but very visible to Ansible.
  git clean -qfd
fi
SHORT=$(git rev-parse --short HEAD)

echo "=== dry-run (--check --diff) ==="
if ! "$VENV/bin/ansible-playbook" site.yml --check --diff > /tmp/gitops-check.log 2>&1; then
  notify "Deploy dry-run FAILED @ $SHORT" "$(tail -c 800 /tmp/gitops-check.log)"
  echo "dry-run failed; see /tmp/gitops-check.log"; exit 1
fi

if [ "$AUTO_APPLY" != "true" ]; then
  notify "Deploy dry-run OK @ $SHORT (apply disabled)" "Review /tmp/gitops-check.log, then apply manually."
  echo "dry-run OK; auto-apply disabled"; exit 0
fi

echo "=== apply ==="
if "$VENV/bin/ansible-playbook" site.yml > /tmp/gitops-apply.log 2>&1; then
  notify "Deploy OK @ $SHORT" "site.yml applied cleanly."
else
  notify "Deploy FAILED @ $SHORT" "$(tail -c 800 /tmp/gitops-apply.log)"; exit 1
fi
