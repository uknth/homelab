# Ansible Global Config
#---------------------------------------------------------------
user: "ansible"
public_key: "{{ vault_public_key }}"
sudo_password: "{{ vault_sudo_password }}"
base_domain: "puhome.net"
config_dir: "/home/{{user}}/.config/homelab"
data_dir: "/home/{{user}}/.local/share/homelab"
timezone: Asia/Kolkata

# control-1
#---------------------------------------------------------------
# beszel
ba_public_key: "{{ vault_ba_public_key }}"
beszel_ext_port: 8090
# glance
# uptimekuma

# nas-2
#---------------------------------------------------------------
# host config
media_base_dir: "/mnt/databank/media"
media_out_dir: "/mnt/databank/storage"
nas1_host: "10.0.2.3"
nas1_username: "{{ vault_nas1_user }}"
nas1_password: "{{ vault_nas1_password }}"
nas1_mount_point: "/mnt/nas1"
nas1_mount_dirs:
  - music
  - video
# vaultwarden
vw_ext_port: 14001
# fusion
fusion_password: "{{ vault_fusion_password }}"
fusion_ext_port: 14002
# media (arr stack)
arr_vpn_user: "{{ vault_arr_vpn_user }}"
arr_vpn_password: "{{ vault_arr_vpn_password }}"
arr_vpn_regions: "{{ vault_arr_vpn_regions }}"
arr_qbittorrent_user: "{{ vault_arr_qbittorrent_user }}"
arr_qbittorrent_password: "{{ vault_arr_qbittorrent_password }}"
arr_qbittorrent_ext_port: 14013
arr_nzbget_ext_port: 14014
arr_prowlarr_ext_port: 14015
arr_sonarr_ext_port: 14016 
arr_radarr_ext_port: 14017
arr_lidarr_ext_port: 14018
arr_bazarr_ext_port: 14019
arr_ytdl_sub_ext_port: 14022
arr_readarr_ext_port: 14023
# media (jellyfin)
jellyfin_nas1_dir: "{{ nas1_mount_point }}"
jellyfin_jellyseerr_ext_port: 14020
jellyfin_ext_port: 14021

# gateway-1
#---------------------------------------------------------------
blocky_ext_port: 14011
blocky_ui_ext_port: 14012
blocky_domain_mapping:
  - {name: "router-1.host.puhome.net", ip: "10.0.2.1"}
  - {name: "puhome.net", ip: "10.0.2.2"} # for backwards compatibility with *.homelab.uknth.me

# certbot & nginx
nginx_certbot_admin_email: "{{ vault_certbot_admin_email }}"
nginx_certbot_cloudflare_email: "{{ vault_certbot_cloudflare_email }}"
nginx_certbot_cloudflare_api_key: "{{ vault_certbot_cloudflare_api_key }}"
nginx_resolver: "10.0.2.2"

#---------------------------------------------------------------
# SERVICE MAPPING
#---------------------------------------------------------------
service_mapping:
  # media services in nas-2
  - {name: "qbittorrent", ip: "10.0.2.2", host: "nas-2", port: "{{ arr_qbittorrent_ext_port }}"}
  - {name: "torrent", ip: "10.0.2.2", host: "nas-2", port: "{{ arr_qbittorrent_ext_port }}"} # alias
  - {name: "nzbget", ip: "10.0.2.2", host: "nas-2", port: "{{ arr_nzbget_ext_port }}"}
  - {name: "prowlarr", ip: "10.0.2.2", host: "nas-2", port: "{{ arr_prowlarr_ext_port }}"}
  - {name: "sonarr", ip: "10.0.2.2", host: "nas-2", port: "{{ arr_sonarr_ext_port }}"}
  - {name: "radarr", ip: "10.0.2.2", host: "nas-2", port: "{{ arr_radarr_ext_port }}"}
  - {name: "lidarr", ip: "10.0.2.2", host: "nas-2", port: "{{ arr_lidarr_ext_port }}"}
  - {name: "bazarr", ip: "10.0.2.2", host: "nas-2", port: "{{ arr_bazarr_ext_port }}"}
  - {name: "readarr", ip: "10.0.2.2", host: "nas-2", port: "{{ arr_readarr_ext_port }}"}
  - {name: "jellyfin", ip: "10.0.2.2", host: "nas-2", port: "{{ jellyfin_ext_port }}"} 
  - {name: "video", ip: "10.0.2.2", host: "nas-2", port: "{{ jellyfin_ext_port }}"} # alias
  - {name: "jellyseerr", ip: "10.0.2.2", host: "nas-2", port: "{{ jellyfin_jellyseerr_ext_port }}"} 
  - {name: "seer", ip: "10.0.2.2", host: "nas-2", port: "{{ jellyfin_jellyseerr_ext_port }}"} #alias
  # fusion on nas-2
  - {name: "fusion", ip: "10.0.2.2", host: "nas-2", port: "{{ fusion_ext_port }}"}
  # vault on nas-2
  - {name: "vault", ip: "10.0.2.2", host: "nas-2", port: "{{ vw_ext_port }}"}
  # beszel monitoring server on control-1 
  - {name: "beszel", ip: "10.0.2.2", host: "control-1", port: "{{ beszel_ext_port }}"}
  - {name: "monitor", ip: "10.0.2.2", host: "control-1", port: "{{ beszel_ext_port }}"} # alias
  # extra services on unmanaged hosts
  - {name: "homeassistant", ip: "10.0.2.2", host: "iot-1", port: "8123"}
#---------------------------------------------------------------
